---
import { withBase } from "../lib/paths";
import type { Locale } from "../lib/i18n";

interface Props {
  locale?: Locale;
}

const { locale = "en" } = Astro.props;
const isPortuguese = locale === "pt";
const isKorean = locale === "ko";
const year = new Date().getFullYear();
---

<footer class="mt-16 border-t" style="border-color: color-mix(in srgb, var(--color-gold) 22%, var(--color-rule)); color: var(--color-muted);">
  <div class="mx-auto grid max-w-6xl gap-6 px-5 py-9 text-sm sm:grid-cols-[1fr_auto] sm:px-6">
    <div class="flex items-start gap-4">
      <img src={withBase("/assets/brand/leopard-mark-192.webp")} alt="" width="54" height="56" class="h-14 w-auto shrink-0" loading="lazy" />
      <div>
        <p class="font-black uppercase tracking-[0.18em]" style="color: var(--color-ink);">Seoul E-Land Digest</p>
        <p class="mt-2 max-w-xl leading-relaxed">
          {isKorean
            ? "서울 이랜드 FC를 경기마다 따라가는 팬이 만드는 독립 매체입니다."
            : isPortuguese
            ? "Cobertura independente em português para torcedores que acompanham o Seoul E-Land FC, partida a partida."
            : "Independent English-language notes for supporters following Seoul E-Land FC, match by match."}
        </p>
      </div>
    </div>
    <div class="flex flex-col gap-2 sm:items-end">
      <div class="flex flex-wrap items-center gap-x-4 gap-y-1 sm:justify-end">
        <a href={withBase("/support")} class="inline-flex min-h-11 items-center font-black no-underline transition-colors hover:text-white sm:min-h-0" style="color: var(--color-gold-light);">{isKorean ? "후원" : isPortuguese ? "Apoie" : "Support me"}</a>
        <a href={withBase(isKorean ? "/ko/about" : isPortuguese ? "/pt/about" : "/about")} class="inline-flex min-h-11 items-center font-black no-underline transition-colors hover:text-white sm:min-h-0" style="color: var(--color-gold-light);">{isKorean ? "소개" : isPortuguese ? "Sobre" : "About"}</a>
      </div>
      <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-xs sm:justify-end">
        <a href={withBase(isKorean ? "/ko/privacy" : isPortuguese ? "/pt/privacy" : "/privacy")} class="inline-flex min-h-11 items-center no-underline transition-colors hover:text-white sm:min-h-0" style="color: var(--color-muted);">{isKorean ? "개인정보 처리방침" : isPortuguese ? "Privacidade" : "Privacy"}</a>
        <a href={withBase("/terms")} class="inline-flex min-h-11 items-center no-underline transition-colors hover:text-white sm:min-h-0" style="color: var(--color-muted);">{isKorean ? "이용약관" : isPortuguese ? "Termos de uso" : "Terms"}</a>
        <a href={withBase("/credits")} class="inline-flex min-h-11 items-center no-underline transition-colors hover:text-white sm:min-h-0" style="color: var(--color-muted);">{isKorean ? "출처 및 고지" : isPortuguese ? "Créditos" : "Credits"}</a>
      </div>
      <span>{isKorean ? "비공식 팬 사이트이며 서울 이랜드 FC 및 K리그와 관련이 없습니다." : isPortuguese ? "Site de torcedor, não oficial, sem vínculo com o Seoul E-Land FC ou a K League." : "Unofficial fan site, not affiliated with Seoul E-Land FC or the K League."}</span>
      <span>© {year} Seoul E-Land Digest</span>
      <span>{isKorean ? "레오파드 팬을 위해 만들었습니다." : isPortuguese ? "Feito para torcedores dos Leopards." : "Made for fans of the Leopards."}</span>
    </div>
  </div>
</footer>
