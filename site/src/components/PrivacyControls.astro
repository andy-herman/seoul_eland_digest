---
// The analytics switch and the "clear game data" button on the privacy pages.
// Strings come in through data attributes so one script serves every language.
interface Props {
  kind: "analytics" | "clear";
  locale?: "en" | "pt" | "ko";
}

const { kind, locale = "en" } = Astro.props;

const STRINGS = {
  en: {
    checking: "Checking whether analytics is on in this browser…",
    gpc: "Analytics is off: your browser is sending a Global Privacy Control signal.",
    on: "Analytics is on in this browser.",
    off: "Analytics is off in this browser.",
    turnOff: "Turn analytics off",
    turnOn: "Turn analytics back on",
    blocked: "This browser is blocking site storage, so the choice cannot be saved.",
    clear: "Clear game progress and settings",
    cleared: "Done. Game progress, scores and settings for this site have been cleared from this browser.",
    clearBlocked: "This browser is blocking site storage, so there is nothing to clear.",
  },
  pt: {
    checking: "Verificando se as estatísticas estão ativadas neste navegador…",
    gpc: "As estatísticas estão desativadas: seu navegador está enviando um sinal Global Privacy Control.",
    on: "As estatísticas estão ativadas neste navegador.",
    off: "As estatísticas estão desativadas neste navegador.",
    turnOff: "Desativar estatísticas",
    turnOn: "Reativar estatísticas",
    blocked: "Este navegador está bloqueando o armazenamento do site, então a escolha não pode ser salva.",
    clear: "Apagar progresso e configurações dos jogos",
    cleared: "Pronto. O progresso, as pontuações e as configurações dos jogos deste site foram apagados deste navegador.",
    clearBlocked: "Este navegador está bloqueando o armazenamento do site, então não há nada para apagar.",
  },
  ko: {
    checking: "이 브라우저에서 방문 통계가 켜져 있는지 확인하는 중입니다…",
    gpc: "방문 통계가 꺼져 있습니다. 브라우저가 Global Privacy Control(GPC) 신호를 보내고 있습니다.",
    on: "이 브라우저에서 방문 통계가 켜져 있습니다.",
    off: "이 브라우저에서 방문 통계가 꺼져 있습니다.",
    turnOff: "방문 통계 끄기",
    turnOn: "방문 통계 다시 켜기",
    blocked: "이 브라우저가 사이트 저장소를 차단하고 있어 선택을 저장할 수 없습니다.",
    clear: "게임 진행 상황과 설정 지우기",
    cleared: "완료했습니다. 이 브라우저에 저장된 이 사이트의 게임 진행 상황, 점수, 설정을 모두 지웠습니다.",
    clearBlocked: "이 브라우저가 사이트 저장소를 차단하고 있어 지울 데이터가 없습니다.",
  },
} as const;

const t = STRINGS[locale];
const boxStyle = "border-color: color-mix(in srgb, var(--color-gold) 30%, var(--color-rule)); background: color-mix(in srgb, white 5%, transparent);";
---

{kind === "analytics" ? (
  <div
    class="not-prose my-5 rounded-2xl border p-4 sm:p-5"
    style={boxStyle}
    data-privacy-analytics
    data-gpc={t.gpc}
    data-on={t.on}
    data-off={t.off}
    data-turn-off={t.turnOff}
    data-turn-on={t.turnOn}
    data-blocked={t.blocked}
  >
    <p class="text-sm leading-6" data-analytics-status aria-live="polite">{t.checking}</p>
    <button type="button" class="mt-3 inline-flex min-h-11 items-center rounded-full px-5 text-sm font-black uppercase tracking-[0.12em]" style="background: var(--color-gold); color: var(--color-navy-deep);" data-analytics-toggle hidden>{t.turnOff}</button>
  </div>
) : (
  <div class="not-prose my-5 rounded-2xl border p-4 sm:p-5" style={boxStyle} data-privacy-clear data-cleared={t.cleared} data-blocked={t.clearBlocked}>
    <button type="button" class="inline-flex min-h-11 items-center rounded-full border px-5 text-sm font-black uppercase tracking-[0.12em]" style="border-color: var(--color-navy); color: var(--color-navy);" data-clear-games>{t.clear}</button>
    <p class="mt-3 text-sm leading-6" data-clear-status aria-live="polite"></p>
  </div>
)}

<script>
  // Same key the layout checks before loading Vercel Web Analytics.
  const OFF_KEY = "sed-analytics-off";
  const gpc = (navigator as Navigator & { globalPrivacyControl?: boolean }).globalPrivacyControl === true;

  function readOff(): boolean {
    try {
      return localStorage.getItem(OFF_KEY) === "1";
    } catch {
      return false;
    }
  }

  for (const box of document.querySelectorAll<HTMLElement>("[data-privacy-analytics]")) {
    const status = box.querySelector<HTMLElement>("[data-analytics-status]");
    const toggle = box.querySelector<HTMLButtonElement>("[data-analytics-toggle]");
    const d = box.dataset;
    const render = () => {
      if (!status || !toggle) return;
      if (gpc) {
        status.textContent = d.gpc ?? "";
        toggle.hidden = true;
        return;
      }
      const off = readOff();
      status.textContent = (off ? d.off : d.on) ?? "";
      toggle.textContent = (off ? d.turnOn : d.turnOff) ?? "";
      toggle.hidden = false;
    };
    toggle?.addEventListener("click", () => {
      try {
        if (readOff()) localStorage.removeItem(OFF_KEY);
        else localStorage.setItem(OFF_KEY, "1");
      } catch {
        if (status) status.textContent = d.blocked ?? "";
        return;
      }
      render();
    });
    render();
  }

  for (const box of document.querySelectorAll<HTMLElement>("[data-privacy-clear]")) {
    const button = box.querySelector<HTMLButtonElement>("[data-clear-games]");
    const status = box.querySelector<HTMLElement>("[data-clear-status]");
    button?.addEventListener("click", () => {
      try {
        const keep = localStorage.getItem(OFF_KEY);
        localStorage.clear();
        if (keep !== null) localStorage.setItem(OFF_KEY, keep);
        if (status) status.textContent = box.dataset.cleared ?? "";
      } catch {
        if (status) status.textContent = box.dataset.blocked ?? "";
      }
    });
  }
</script>
