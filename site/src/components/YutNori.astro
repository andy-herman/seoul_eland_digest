---
import TranslateButton from "./TranslateButton.astro";
import { withBase } from "../lib/paths";
import { RIVAL_CHOICES, YUT_STRINGS, tierLabel, type Locale } from "../yut/i18n";

interface Props {
  locale?: Locale;
}

const { locale = "en" } = Astro.props;
const t = YUT_STRINGS[locale];
const isPt = locale === "pt";
const drivers = withBase("/play/kart/drivers/");
const heads = withBase("/play/h2h/heads/");
const mascots = withBase("/play/h2h/mascot-heads/");
---

<div class="yut-page">
  <header class="supporter-panel rounded-[1.25rem] sm:rounded-[2rem]">
    <div class="relative flex flex-wrap items-end justify-between gap-x-6 gap-y-3 p-4 sm:p-7">
      <div>
        <p class="eyebrow">{t.eyebrow}</p>
        <h1 class="mt-2 max-w-3xl text-[1.8rem] font-black uppercase leading-[1.02] tracking-tight sm:text-4xl">
          {t.heading} <span class="yut-ko">{t.ko}</span>
        </h1>
        <p class="mt-2 max-w-3xl text-sm leading-6 sm:text-base" style="color: var(--color-link);">{t.intro}</p>
      </div>
      {
        isPt ? (
          <TranslateButton href="/play/yut-nori" code="EN" label={t.translateLabel} ariaLabel={t.translateAria} />
        ) : (
          <TranslateButton href="/pt/play/yut-nori" code="PT" label={t.translateLabel} ariaLabel={t.translateAria} />
        )
      }
    </div>
  </header>

  <section
    class="yut-game"
    data-yut-root
    data-locale={locale}
    data-mode="menu"
    data-drivers={drivers}
    data-heads={heads}
    data-mascots={mascots}
    data-song={withBase("/play/seoul-song-2024.mp3")}
  >
    <div class="yut-screen yut-menu" data-yut-screen="menu">
      <div class="yut-poster">
        <img class="yut-poster-leoul" src={withBase("/play/leoul-kick.webp")} alt="" width="440" height="560" />
        <div class="yut-poster-title">
          <small>Seoul E-Land Digest</small>
          <b>{t.heading}</b>
          <span>{t.ko}</span>
        </div>
        <img class="yut-poster-lenyang" src={withBase("/play/lenyang-jump.webp")} alt="" width="365" height="539" />
      </div>

      <div class="yut-menu-grid">
        <section class="yut-card yut-start-card">
          <p class="yut-kicker">{t.play}</p>
          <div class="yut-mode-row">
            <button type="button" data-mode-choice aria-pressed="true">{t.rivalMode}</button>
            <button type="button" data-mode-choice data-mode-pass aria-pressed="false">{t.passMode}</button>
          </div>
          <div>
            <h2>{t.pickStrength}</h2>
            <div class="yut-ai-row">
              <button type="button" data-ai-level="friendly" aria-pressed="true">{t.friendly}</button>
              <button type="button" data-ai-level="pro" aria-pressed="false">{t.pro}</button>
              <button type="button" data-ai-level="random" aria-pressed="false">{t.random}</button>
            </div>
          </div>
          <button type="button" class="yut-primary yut-play-button" data-yut-play>▶ {t.play}</button>
        </section>

        <section class="yut-card yut-rival-card">
          <p class="yut-kicker">{t.pickRival}</p>
          <div class="yut-rivals" data-yut-rivals>
            {
              RIVAL_CHOICES.map((choice) => (
                <button type="button" class="yut-rival" data-rival={choice.slug} aria-pressed={choice.slug === "busan-ipark" ? "true" : "false"} style={`--rival:${choice.color}`}>
                  <img src={`${mascots}${choice.slug}.webp`} alt="" width="48" height="48" loading="lazy" />
                  <span>
                    <b>{choice.name}</b>
                    <small>{choice.club}</small>
                  </span>
                  <em>{tierLabel(locale, choice.slug)}</em>
                </button>
              ))
            }
          </div>
        </section>

        <section class="yut-card yut-how-card">
          <p class="yut-kicker">{t.howTitle}</p>
          <div class="yut-throw-table">
            {
              Object.values(t.throwNames).map((row) => (
                <span>
                  <b>{row.ko}</b>
                  <small>{row.roman}</small>
                  <em>{row.meaning}</em>
                  <strong>{row.steps}</strong>
                </span>
              ))
            }
          </div>
          <ul>{t.hints.map((hint) => <li>{hint}</li>)}</ul>
        </section>
      </div>
    </div>

    <div class="yut-screen yut-play" data-yut-screen="play" hidden>
      <div class="yut-topbar">
        <button type="button" class="yut-icon" data-yut-menu aria-label={t.menu}>←</button>
        <div class="yut-scorebox">
          <small>{t.scoreboard}</small>
          <b data-yut-score></b>
        </div>
        <div class="yut-turnbox">
          <small>{t.turn}</small>
          <b data-yut-turn></b>
        </div>
        <button type="button" class="yut-icon" data-yut-mute>{t.mute}</button>
      </div>

      <div class="yut-arena">
        <section class="yut-board-panel">
          <canvas data-yut-board aria-label={t.heading}></canvas>
          <p class="yut-commentary" data-yut-message></p>
        </section>

        <aside class="yut-side">
          <section class="yut-throw-box">
            <canvas data-yut-throw-canvas aria-label={t.throw}></canvas>
            <div class="yut-throw-actions">
              <button type="button" class="yut-primary" data-yut-throw>{t.throw}</button>
              <p data-yut-result-card></p>
            </div>
          </section>

          <section class="yut-panel">
            <h3>{t.queue}</h3>
            <div class="yut-queue" data-yut-queue></div>
          </section>

          <section class="yut-panel">
            <h3>{t.confirm}</h3>
            <div class="yut-moves" data-yut-moves></div>
            <button type="button" data-yut-cancel>{t.cancel}</button>
          </section>

          <section class="yut-teams">
            <div class="yut-team-row">
              <b>Seoul E-Land</b>
              <small>{t.bench}</small>
              <div class="yut-row" data-yut-bench="0"></div>
              <small>{t.home}</small>
              <div class="yut-row" data-yut-home="0"></div>
            </div>
            <div class="yut-team-row">
              <b>{t.rivalMode}</b>
              <small>{t.bench}</small>
              <div class="yut-row" data-yut-bench="1"></div>
              <small>{t.home}</small>
              <div class="yut-row" data-yut-home="1"></div>
            </div>
          </section>
        </aside>
      </div>
    </div>

    <div class="yut-screen yut-result" data-yut-screen="result" hidden>
      <div class="yut-result-art">
        <img src={withBase("/play/leoul-celebrate.webp")} alt="" width="468" height="667" />
        <img src={withBase("/play/lenyang-hug.webp")} alt="" width="420" height="560" />
        <img data-yut-result-rival src={`${mascots}busan-ipark.webp`} alt="" width="160" height="160" />
      </div>
      <div class="yut-result-card">
        <p class="yut-kicker">{t.result}</p>
        <h2 data-yut-result-title></h2>
        <p data-yut-result-score></p>
        <p data-yut-record></p>
        <div class="yut-buttons">
          <button type="button" class="yut-primary" data-yut-rematch>{t.rematch}</button>
          <button type="button" data-yut-restart>{t.restart}</button>
          <button type="button" data-yut-menu>{t.menu}</button>
        </div>
      </div>
    </div>
  </section>

  <section class="yut-info">
    <div>
      <h2>{t.howTitle}</h2>
      <ul>{t.how.map((line) => <li>{line}</li>)}</ul>
    </div>
    <div>
      <h2>{t.controlsTitle}</h2>
      <ul>{t.controls.map((line) => <li>{line}</li>)}</ul>
    </div>
    <p class="yut-credits">{t.credits}</p>
  </section>
</div>

<script>
  import { mountYutNori } from "../yut/main";
  for (const root of document.querySelectorAll("[data-yut-root]")) mountYutNori(root as HTMLElement);
</script>

<style is:global>
  .yut-lock-scroll { overflow: hidden; }
  .yut-page { display: grid; gap: 1rem; }
  .yut-ko { display: inline-block; font-size: .62em; letter-spacing: 0; color: var(--color-gold, #f2b705); vertical-align: middle; }
  .yut-game { --ink: #0b1238; --gold: #ffc23a; --navy: #1b2446; --cream: #fff7d6; color: #fff; scroll-margin-top: 5.5rem; }
  .yut-game button { min-height: 44px; font: inherit; }
  .yut-screen { border: 4px solid var(--ink); border-radius: 1.2rem; background: #0f1d46; box-shadow: 0 8px 0 var(--ink); padding: 1rem; }
  .yut-screen[hidden] { display: none; }
  .yut-kicker { margin: 0; font-size: .78rem; font-weight: 1000; letter-spacing: .12em; text-transform: uppercase; color: var(--gold); }
  .yut-primary { background: #ffe38a !important; }
  .yut-game button { border: 3px solid var(--ink); border-radius: 999px; background: #fff; color: #15182a; font-weight: 950; padding: .58rem 1rem; box-shadow: 0 3px 0 var(--ink); cursor: pointer; }
  .yut-game button:disabled { opacity: .52; cursor: default; filter: grayscale(.15); }
  .yut-game button:not(:disabled):active { transform: translateY(2px); box-shadow: 0 1px 0 var(--ink); }
  .yut-game button[aria-pressed="true"], .yut-chip[data-sel="true"], .yut-move[data-sel="true"] { background: #8ff0b3 !important; }

  .yut-poster { position: relative; min-height: clamp(15rem, 36vw, 25rem); overflow: hidden; border: 3px solid var(--ink); border-radius: 1rem; background: repeating-linear-gradient(0deg, #237545 0 11%, #2b8750 11% 22%); }
  .yut-poster::before { content: ""; position: absolute; inset: 12% 9%; border: 5px solid rgba(255, 255, 255, .65); border-radius: .8rem; transform: perspective(650px) rotateX(56deg); }
  .yut-poster::after { content: ""; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(6, 12, 36, 0) 38%, rgba(6, 12, 36, .76)); }
  .yut-poster > img { position: absolute; bottom: -5%; z-index: 2; width: auto; filter: drop-shadow(0 8px 0 rgba(0, 0, 0, .35)); }
  .yut-poster-leoul { left: 2%; height: 90%; }
  .yut-poster-lenyang { right: 4%; height: 82%; }
  .yut-poster-title { position: absolute; z-index: 3; inset: 0; display: grid; place-content: center; text-align: center; text-shadow: 0 5px 0 var(--ink); }
  .yut-poster-title small { color: var(--gold); font-weight: 1000; letter-spacing: .14em; text-transform: uppercase; }
  .yut-poster-title b { font-size: clamp(2.35rem, 8vw, 6.4rem); line-height: .82; font-weight: 1000; text-transform: uppercase; -webkit-text-stroke: 2px var(--ink); }
  .yut-poster-title span { color: var(--gold); font-size: clamp(1.2rem, 3.4vw, 2.35rem); font-weight: 1000; }

  .yut-menu-grid { display: grid; grid-template-columns: minmax(16rem, .72fr) minmax(18rem, 1.28fr); gap: 1rem; margin-top: 1rem; }
  .yut-card { display: grid; gap: .85rem; align-content: start; padding: 1rem; border-radius: 1rem; background: rgba(255, 255, 255, .08); }
  .yut-card h2, .yut-info h2 { margin: 0; font-size: 1.1rem; font-weight: 1000; text-transform: uppercase; }
  .yut-mode-row, .yut-ai-row, .yut-buttons, .yut-throw-actions { display: flex; flex-wrap: wrap; gap: .6rem; align-items: center; }
  .yut-play-button { justify-self: start; padding-inline: 1.3rem !important; }
  .yut-rivals { display: grid; grid-template-columns: repeat(auto-fit, minmax(12.5rem, 1fr)); gap: .55rem; max-height: 27rem; overflow: auto; padding-right: .15rem; }
  .yut-rival { display: grid; grid-template-columns: 48px minmax(0, 1fr) auto; align-items: center; gap: .55rem; border-radius: .9rem !important; text-align: left; padding: .45rem .6rem !important; background: linear-gradient(90deg, color-mix(in srgb, var(--rival) 24%, #fff), #fff) !important; }
  .yut-rival img { width: 48px; height: 48px; border-radius: 50%; object-fit: contain; background: #fff; border: 3px solid var(--rival); }
  .yut-rival span { display: grid; min-width: 0; }
  .yut-rival b, .yut-rival small { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .yut-rival small { opacity: .72; font-size: .72rem; }
  .yut-rival em { font-style: normal; color: var(--rival); font-size: .72rem; }
  .yut-how-card { grid-column: 1 / -1; }
  .yut-throw-table { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: .45rem; }
  .yut-throw-table span { display: grid; gap: .1rem; padding: .6rem; border-radius: .8rem; background: rgba(255, 255, 255, .1); text-align: center; }
  .yut-throw-table b { font-size: 1.35rem; color: var(--gold); }
  .yut-throw-table small, .yut-throw-table em { font-style: normal; opacity: .8; }
  .yut-throw-table strong { color: #fff; }
  .yut-card ul, .yut-info ul { margin: 0; padding-left: 1.15rem; line-height: 1.55; }

  .yut-play { padding: .65rem; min-height: min(74dvh, 52rem); }
  .yut-topbar { display: grid; grid-template-columns: auto minmax(0, 1fr) auto auto; gap: .55rem; align-items: center; margin-bottom: .65rem; }
  .yut-icon { min-width: 44px; padding-inline: .75rem !important; }
  .yut-scorebox, .yut-turnbox { display: grid; padding: .48rem .75rem; border: 2px solid rgba(255, 255, 255, .22); border-radius: .85rem; background: rgba(255, 255, 255, .08); }
  .yut-scorebox small, .yut-turnbox small, .yut-panel h3, .yut-team-row small { text-transform: uppercase; letter-spacing: .1em; opacity: .76; font-size: .68rem; font-weight: 1000; }
  .yut-scorebox b { font-size: clamp(1rem, 3vw, 1.55rem); }
  .yut-arena { display: grid; grid-template-columns: minmax(0, 1fr) minmax(18rem, .4fr); gap: .75rem; }
  .yut-board-panel { position: relative; min-height: 38rem; border: 3px solid var(--ink); border-radius: 1rem; overflow: hidden; background: #126136; }
  .yut-board-panel canvas { display: block; width: 100%; height: 100%; min-height: 38rem; touch-action: none; user-select: none; -webkit-user-select: none; }
  .yut-commentary { position: absolute; left: .75rem; right: .75rem; bottom: .75rem; margin: 0; padding: .65rem .8rem; border-left: 5px solid var(--gold); border-radius: .75rem; background: rgba(7, 20, 51, .82); color: #fff7c2; font-weight: 900; }
  .yut-side { display: grid; gap: .6rem; align-content: start; }
  .yut-throw-box, .yut-panel, .yut-teams { display: grid; gap: .55rem; padding: .7rem; border-radius: .9rem; background: rgba(255, 255, 255, .08); }
  .yut-throw-box canvas { width: 100%; aspect-ratio: 16 / 9; border-radius: .8rem; background: radial-gradient(circle at 50% 45%, #c7975e, #6f431d); touch-action: none; cursor: grab; }
  .yut-throw-actions p { flex: 1; min-width: 8rem; margin: 0; color: #ffeaa4; font-weight: 900; }
  .yut-queue, .yut-moves, .yut-row { display: flex; flex-wrap: wrap; gap: .45rem; align-items: center; min-height: 2.4rem; }
  .yut-chip { display: inline-flex; align-items: center; gap: .4rem; padding: .42rem .7rem !important; }
  .yut-chip b { font-size: 1.15rem; color: var(--navy); }
  .yut-chip span { color: #334155; }
  .yut-move { display: grid; grid-template-columns: 38px minmax(0, 1fr); grid-template-rows: auto auto; column-gap: .5rem; align-items: center; min-width: min(100%, 12rem); border-radius: .85rem !important; text-align: left; }
  .yut-move .yut-mini-token { grid-row: 1 / 3; }
  .yut-move b, .yut-move small { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .yut-move small { opacity: .72; font-size: .72rem; }
  .yut-muted { margin: 0; opacity: .8; font-weight: 800; }
  .yut-teams { grid-template-columns: 1fr; }
  .yut-team-row { display: grid; grid-template-columns: 1fr; gap: .28rem; }
  .yut-team-row b { font-size: .9rem; }
  .yut-row-token, .yut-mini-token { position: relative; display: inline-grid; place-items: center; width: 44px; height: 44px; border-radius: 999px; background: var(--token); border: 4px solid var(--rim); overflow: hidden; box-shadow: 0 3px 0 var(--ink); padding: 0; }
  button.yut-row-token { cursor: pointer; }
  .yut-row-token-home { opacity: .86; filter: saturate(.8); }
  .yut-row-token img, .yut-mini-token img { width: 100%; height: 100%; border-radius: 999px; object-fit: contain; }
  .yut-row-token img.yut-front-crop, .yut-mini-token img.yut-front-crop { width: 300%; max-width: none; height: 100%; object-fit: cover; object-position: right center; transform: translateX(-66%); }
  .yut-row-token i, .yut-mini-token i { position: absolute; right: 0; top: 0; min-width: 19px; height: 19px; display: grid; place-items: center; border-radius: 999px; background: #ef4444; color: #fff; font-size: .66rem; font-style: normal; font-weight: 1000; box-shadow: 0 0 0 2px #fff; }
  .yut-row-token i:empty, .yut-mini-token i:empty { display: none; }

  .yut-result { grid-template-columns: minmax(12rem, .85fr) minmax(0, 1.15fr); gap: 1rem; align-items: center; overflow: hidden; }
  .yut-result-art { position: relative; min-height: 17rem; border-radius: 1rem; background: radial-gradient(circle at 50% 50%, #2f8a4c, #11243a); overflow: hidden; border: 3px solid var(--ink); }
  .yut-result-art img { position: absolute; width: auto; filter: drop-shadow(0 8px 0 rgba(0, 0, 0, .35)); }
  .yut-result-art img:nth-child(1) { left: 3%; bottom: -10%; height: 96%; }
  .yut-result-art img:nth-child(2) { right: 5%; bottom: -8%; height: 83%; }
  .yut-result-art img:nth-child(3) { right: 38%; top: 7%; width: 28%; height: auto; border-radius: 50%; background: #fff; border: 5px solid var(--gold); }
  .yut-result-card { display: grid; gap: .65rem; }
  .yut-result-card h2 { margin: 0; font-size: clamp(2rem, 7vw, 4.7rem); line-height: .9; font-weight: 1000; text-transform: uppercase; color: var(--gold); text-shadow: 0 4px 0 var(--ink); }
  .yut-result-card p { margin: 0; font-weight: 900; }

  .yut-info { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 21rem), 1fr)); gap: 1rem; padding: 1rem; border: 4px solid #0b1238; border-radius: 1.2rem; background: #fbf7ef; color: #15182a; box-shadow: 0 8px 0 #0b1238; }
  .yut-credits { grid-column: 1 / -1; margin: 0; font-size: .9rem; font-weight: 800; }

  @media (pointer: coarse) {
    .yut-game[data-mode="play"] { position: fixed; z-index: 80; inset: 0; min-height: 100dvh; padding: max(.45rem, env(safe-area-inset-top)) max(.45rem, env(safe-area-inset-right)) max(.45rem, env(safe-area-inset-bottom)) max(.45rem, env(safe-area-inset-left)); background: #071433; overflow: auto; }
    .yut-game[data-mode="play"] .yut-play { min-height: calc(100dvh - env(safe-area-inset-top) - env(safe-area-inset-bottom) - .9rem); border-radius: .9rem; box-shadow: none; }
  }

  @media (max-width: 900px) {
    .yut-menu-grid { grid-template-columns: 1fr; }
    .yut-throw-table { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .yut-arena { grid-template-columns: 1fr; }
    .yut-board-panel, .yut-board-panel canvas { min-height: min(62dvh, 35rem); }
    .yut-result { grid-template-columns: 1fr; }
    .yut-poster-leoul { left: -5%; }
    .yut-poster-lenyang { right: -7%; }
  }

  @media (max-width: 540px) {
    .yut-screen { padding: .7rem; }
    .yut-topbar { grid-template-columns: auto 1fr auto; }
    .yut-turnbox { grid-column: 1 / -1; }
    .yut-poster-title b { font-size: clamp(2rem, 17vw, 4.7rem); }
    .yut-poster-leoul { height: 72%; }
    .yut-poster-lenyang { height: 66%; }
  }

  @media (max-height: 480px) and (orientation: landscape) {
    .yut-game[data-mode="play"] .yut-play { padding: .35rem; }
    .yut-topbar { margin-bottom: .35rem; }
    .yut-arena { grid-template-columns: minmax(0, 1fr) minmax(17rem, .44fr); }
    .yut-board-panel, .yut-board-panel canvas { min-height: calc(100dvh - 4.6rem); }
    .yut-throw-box canvas { aspect-ratio: 16 / 5.6; }
    .yut-commentary { font-size: .82rem; padding: .45rem .6rem; }
  }
</style>
