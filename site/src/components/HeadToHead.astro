---
import TranslateButton from "./TranslateButton.astro";
import { withBase } from "../lib/paths";
import { H2H_STRINGS } from "../h2h/i18n";
import { OPPONENTS, OPPONENT_SLUGS, SQUAD, playerStats, type Locale } from "../h2h/data";

interface Props {
  locale?: Locale;
}

const { locale = "en" } = Astro.props;
const t = H2H_STRINGS[locale];
const isPt = locale === "pt";
const asset = (file: string) => withBase(`/play/h2h/${file}`);
const groups = [
  { id: "GK", label: "GK", positions: ["GK"] },
  { id: "DF", label: "DF", positions: ["DF"] },
  { id: "MF", label: "MF", positions: ["MF", "AM"] },
  { id: "FW", label: "FW", positions: ["FW"] },
];
---

<div class="h2h-page">
  <header class="supporter-panel h2h-hero rounded-[1.25rem] sm:rounded-[2rem]">
    <div class="relative flex flex-wrap items-end justify-between gap-x-6 gap-y-3 p-4 sm:p-7">
      <div>
        <p class="eyebrow">{t.eyebrow}</p>
        <h1 class="mt-2 max-w-3xl text-[1.65rem] font-black uppercase leading-[1.02] tracking-tight sm:text-4xl">{t.heading}</h1>
        <p class="mt-2 max-w-3xl text-sm leading-6 sm:text-base" style="color: var(--color-link);">{t.intro}</p>
      </div>
      {isPt ? (
        <TranslateButton href="/play/head-to-head" code="EN" label={t.translateLabel} ariaLabel={t.translateAria} />
      ) : (
        <TranslateButton href="/pt/play/head-to-head" code="PT" label={t.translateLabel} ariaLabel={t.translateAria} />
      )}
    </div>
  </header>

  <section class="h2h-game" data-h2h-root data-locale={locale} data-assets={asset("")} data-play-assets={withBase("/play/")} data-music={withBase("/play/seoul-song-2024.mp3")}>
    <div class="h2h-hud" data-h2h-hud hidden>
      <span class="h2h-hud-team"><span class="h2h-hud-head" data-side="home"></span><span>SEOUL E-LAND<small data-h2h-hud-player>서울 이랜드</small></span></span>
      <span class="h2h-clock" data-h2h-clock>1:30</span>
      <strong data-h2h-score>0 : 0</strong>
      <span class="h2h-hud-team h2h-hud-rival"><span><b data-h2h-hud-rival-name>RONNY</b><small data-h2h-hud-rival-ko>로니</small></span><span class="h2h-hud-head" data-side="rival"></span></span>
      <span class="h2h-meter"><span data-h2h-power style="--p:0"></span></span>
      <span class="h2h-meter h2h-meter-rival"><span data-h2h-rival-power style="--p:0"></span></span>
      <button type="button" data-h2h-mute aria-label="Sound">♪</button>
      <button type="button" data-h2h-pause>{t.pause}</button>
    </div>

    <div class="h2h-stage" data-h2h-stage>
      <canvas data-h2h-canvas width="1600" height="900" aria-label={t.heading}></canvas>

      <div class="h2h-screen" data-h2h-screen="loading"><p>{t.loading}</p></div>

      <div class="h2h-screen h2h-select" data-h2h-screen="select" hidden>
        <h2>{t.playerSelect}</h2>
        <p>{t.playerHelp}</p>
        <div class="h2h-preview">
          <img data-h2h-preview-img src={asset(`stickers/${SQUAD[0].num}-home.webp`)} alt="" width="220" height="330" />
          <div>
            <p class="h2h-selected" data-h2h-selected></p>
            <p data-h2h-preview-line>{t.seasonLine(SQUAD[0].goals, SQUAD[0].assists, SQUAD[0].apps)}</p>
            <div class="h2h-preview-bars" data-h2h-preview-bars></div>
          </div>
        </div>
        <div class="h2h-roster">
          {groups.map((group) => (
            <section>
              <h3>{group.label}</h3>
              <div class="h2h-player-grid">
                {SQUAD.filter((p) => group.positions.includes(p.pos)).map((p) => {
                  const s = playerStats(p);
                  return (
                    <button type="button" class="h2h-player-card" data-h2h-player={p.num} aria-pressed="false">
                      <img src={asset(`thumbs/${p.num}.webp`)} alt="" width="132" height="132" loading="lazy" />
                      <span><strong>#{p.num} {p.ko}</strong><small>{p.en} · {p.pos}</small></span>
                      <em><i style={`--v:${s.speed}`}></i><i style={`--v:${s.jump}`}></i><i style={`--v:${s.shot}`}></i></em>
                    </button>
                  );
                })}
              </div>
            </section>
          ))}
        </div>
        <div class="h2h-actions">
          <button type="button" class="h2h-primary" data-h2h-to-season>{t.season}</button>
          <button type="button" data-h2h-to-quick>{t.quick}</button>
        </div>
      </div>

      <div class="h2h-screen h2h-season" data-h2h-screen="season" hidden>
        <div class="h2h-season-top">
          <div class="h2h-next-card">
            <img data-h2h-next-img src={asset("mascot-heads/ansan-greeners.webp")} alt="" width="72" height="72" />
            <div>
              <h2>{t.nextFixture}</h2>
              <p class="h2h-next-round" data-h2h-next-round></p>
              <p data-h2h-next></p>
            </div>
          </div>
          <div class="h2h-actions">
            <button type="button" class="h2h-primary" data-h2h-play-next>{t.playNext}</button>
            <button type="button" data-h2h-new-season>{t.newSeason}</button>
            <button type="button" data-h2h-to-select>{t.playerSelect}</button>
          </div>
        </div>
        <div class="h2h-season-grid">
          <section>
            <h2>{t.table}</h2>
            <div class="h2h-table-wrap"><table class="h2h-table"><thead><tr><th>#</th><th>{isPt ? "Time" : "Team"}</th><th>{isPt ? "J" : "P"}</th><th>{isPt ? "V" : "W"}</th><th>{isPt ? "E" : "D"}</th><th>{isPt ? "D" : "L"}</th><th class="h2h-opt">{isPt ? "GP" : "GF"}</th><th class="h2h-opt">{isPt ? "GC" : "GA"}</th><th>{isPt ? "SG" : "GD"}</th><th>{isPt ? "Pts" : "Pts"}</th></tr></thead><tbody data-h2h-table></tbody></table></div>
            <p class="h2h-legend"><span class="h2h-zone-up"></span>{t.zonePromoted}<span class="h2h-zone-po"></span>{t.zonePlayoff}<span class="h2h-zone-rel"></span>{t.zoneRelegation}</p>
          </section>
          <section>
            <h2>{t.fixtures}</h2>
            <ol class="h2h-fixtures" data-h2h-fixtures></ol>
          </section>
        </div>
      </div>

      <div class="h2h-screen h2h-quick" data-h2h-screen="quick" hidden>
        <h2>{t.quickMatch}</h2>
        <div class="h2h-kit-toggle">
          <button type="button" data-h2h-kit="home" aria-pressed="true">{t.homeLabel}</button>
          <button type="button" data-h2h-kit="away" aria-pressed="false">{t.awayLabel}</button>
        </div>
        <div class="h2h-quick-grid">
          {OPPONENT_SLUGS.map((slug) => (
            <button type="button" data-h2h-quick={slug}>
              <img class="h2h-mascot-thumb" src={asset(`mascot-heads/${slug}.webp`)} alt="" width="54" height="54" loading="lazy" style={`background-color:${OPPONENTS[slug].color}`} />
              <span>{OPPONENTS[slug].name}<small>{OPPONENTS[slug].club}</small></span>
            </button>
          ))}
        </div>
        <button type="button" data-h2h-to-season>{t.menu}</button>
      </div>

      <div class="h2h-screen h2h-pause" data-h2h-screen="paused" hidden>
        <div class="h2h-pause-card">
          <p class="h2h-pause-title">{t.pausedTitle}</p>
          <p class="h2h-pause-score" data-h2h-pause-score>0 : 0</p>
          <div class="h2h-pause-actions">
            <button type="button" class="h2h-primary" data-h2h-resume>{t.resume}</button>
            <button type="button" data-h2h-menu>{t.leaveMatch}</button>
          </div>
          <p class="h2h-pause-hint">{t.pausedHint}</p>
        </div>
      </div>

      <div class="h2h-screen h2h-result" data-h2h-screen="result" data-outcome="win" hidden>
        <div class="h2h-confetti" data-h2h-result-confetti aria-hidden="true"></div>
        <p class="h2h-banner" data-h2h-result-banner>{t.banner.win}</p>
        <p class="h2h-result-meta" data-h2h-result-meta></p>
        <div class="h2h-scoreline">
          <figure class="h2h-side">
            <span class="h2h-avatar h2h-avatar-home"><img data-h2h-result-home-img src={asset(`heads/${SQUAD[0].num}.webp`)} alt="" width="120" height="120" /></span>
            <figcaption data-h2h-result-home-name>#{SQUAD[0].num} {SQUAD[0].ko}</figcaption>
            <p class="h2h-goal-mins" data-h2h-result-home-goals></p>
          </figure>
          <p class="h2h-big-score" data-h2h-result-score>0 : 0</p>
          <figure class="h2h-side">
            <span class="h2h-avatar h2h-avatar-rival" data-h2h-result-rival-ring><img data-h2h-result-rival-img src={asset("mascot-heads/ansan-greeners.webp")} alt="" width="120" height="120" /></span>
            <figcaption data-h2h-result-rival-name>Ronny</figcaption>
            <p class="h2h-goal-mins" data-h2h-result-rival-goals></p>
          </figure>
        </div>
        <p class="h2h-result-line"><span class="h2h-points" data-h2h-result-points>+3 pts</span><span data-h2h-result-line></span></p>
        <div class="h2h-stat-rows">
          {[["kicks", t.statKicks], ["headers", t.statHeaders], ["power", t.statPower], ["territory", t.statTerritory]].map(([key, label]) => (
            <div class="h2h-stat-row" data-h2h-stat={key} style="--l:.5">
              <b data-h2h-stat-home>0</b><span>{label}</span><b data-h2h-stat-rival>0</b>
              <i><em></em></i>
            </div>
          ))}
        </div>
        <div class="h2h-mini" data-h2h-result-mini hidden>
          <p class="h2h-mini-head"><span>{t.leaguePosition}</span><strong data-h2h-result-move></strong></p>
          <ol class="h2h-mini-rows" data-h2h-result-rows></ol>
        </div>
        <div class="h2h-actions">
          <button type="button" class="h2h-primary h2h-big-btn" data-h2h-result-continue>{t.continue}</button>
          <button type="button" data-h2h-rematch hidden>{t.rematch}</button>
        </div>
      </div>

      <div class="h2h-screen h2h-end" data-h2h-screen="end" data-variant="champion" hidden>
        <div class="h2h-confetti" data-h2h-end-confetti aria-hidden="true"></div>
        <p class="h2h-end-kicker">{t.season} 2026</p>
        <h2 class="h2h-end-title" data-h2h-end-title>{t.endTitle.champion}</h2>
        <p class="h2h-end-line" data-h2h-end-text></p>
        <div class="h2h-end-hero">
          <img class="h2h-end-trophy" data-h2h-end-trophy src={asset("trophy.webp")} alt="" width="231" height="260" />
          <img class="h2h-end-sticker" data-h2h-end-sticker src={asset(`stickers/${SQUAD[0].num}-home.webp`)} alt="" width="450" height="440" />
          <div class="h2h-end-pos"><strong data-h2h-end-pos>1st</strong><span>{t.ofTeams}</span></div>
        </div>
        <dl class="h2h-end-stats">
          <div><dt>{t.endRecord}</dt><dd data-h2h-end-record>0-0-0</dd></div>
          <div><dt>{t.endGoals}</dt><dd data-h2h-end-goals>0-0</dd></div>
          <div><dt>{t.endPoints}</dt><dd data-h2h-end-points>0</dd></div>
          <div><dt>{t.endBestWin}</dt><dd data-h2h-end-best>-</dd></div>
        </dl>
        <div class="h2h-beaten">
          <p>{t.endBeaten}</p>
          <div class="h2h-beaten-grid" data-h2h-end-beaten></div>
        </div>
        <div class="h2h-actions">
          <button type="button" class="h2h-primary h2h-big-btn" data-h2h-new-season>{t.newSeason}</button>
          <button type="button" data-h2h-to-select>{t.playerSelect}</button>
        </div>
      </div>

      <div class="h2h-vs" data-h2h-vs hidden>
        <div class="h2h-vs-side h2h-vs-left">
          <span class="h2h-vs-club">SEOUL E-LAND</span>
          <img data-h2h-vs-player src={asset(`stickers/${SQUAD[0].num}-home.webp`)} alt="" width="220" height="330" />
          <strong data-h2h-vs-player-name>#{SQUAD[0].num} {SQUAD[0].ko}</strong>
          <small data-h2h-vs-player-sub>{SQUAD[0].en}</small>
        </div>
        <div class="h2h-vs-mark" aria-hidden="true">VS</div>
        <div class="h2h-vs-side h2h-vs-right">
          <span class="h2h-vs-club" data-h2h-vs-rival-club>{OPPONENTS[OPPONENT_SLUGS[0]].club}</span>
          <span class="h2h-vs-ring"><img data-h2h-vs-rival src={asset(`mascot-heads/${OPPONENT_SLUGS[0]}.webp`)} alt="" width="200" height="200" /></span>
          <strong data-h2h-vs-rival-name>{OPPONENTS[OPPONENT_SLUGS[0]].korean}</strong>
          <small data-h2h-vs-rival-sub>{OPPONENTS[OPPONENT_SLUGS[0]].name}</small>
        </div>
        <p class="h2h-vs-meta" data-h2h-vs-meta></p>
        <p class="h2h-vs-skip">{t.tapToSkip}</p>
      </div>
    </div>

    <div class="h2h-touch" data-h2h-touch hidden>
      <div>
        <button type="button" data-h2h-btn="left">◀</button>
        <button type="button" data-h2h-btn="right">▶</button>
      </div>
      <div>
        <button type="button" data-h2h-btn="jump" aria-label={t.jump}>↑</button>
        <button type="button" data-h2h-btn="kick" aria-label={t.kick}>⚽</button>
        <button type="button" data-h2h-btn="power" aria-label={t.power}>⚡</button>
      </div>
    </div>
  </section>

  <details class="h2h-how">
    <summary>{t.controls}</summary>
    <p>{t.credits}</p>
  </details>
</div>

<script>
  import { mountHeadToHead } from "../h2h/main";
  for (const root of document.querySelectorAll("[data-h2h-root]")) mountHeadToHead(root as HTMLElement);
</script>

<style>
  :global(.h2h-lock-scroll) { overflow: hidden; touch-action: none; }
  .h2h-page { display: grid; gap: 1rem; min-width: 0; }
  .h2h-hero { background: linear-gradient(135deg, #fbf7ef 0%, #eaf0ff 100%); }
  .h2h-hero h1 { color: var(--color-navy); text-shadow: none; }
  .h2h-hero p:not(.eyebrow) { color: #46516f !important; }
  .h2h-game { display: grid; gap: .65rem; }
  .h2h-stage { position: relative; display: block; width: 100%; min-width: 0; border: 0; border-radius: 1.4rem; overflow: visible; background: transparent; box-shadow: none; touch-action: none; }
  .h2h-stage canvas { display: none; max-width: 100%; height: auto !important; aspect-ratio: 16 / 9; background: #90cdf4; border: 4px solid #111a33; border-radius: 1.4rem; box-shadow: 0 8px 0 #111a33; }
  .h2h-game[data-mode="match"] .h2h-stage canvas,
  .h2h-game[data-mode="paused"] .h2h-stage canvas { display: block; }
  .h2h-hud { display: flex; align-items: center; justify-content: center; gap: .45rem; flex-wrap: nowrap; color: #111a33; font-weight: 900; min-width: 0; }
  .h2h-hud button, .h2h-actions button, .h2h-touch button, .h2h-screen button { border: 2px solid #111a33; border-radius: 999px; background: #fff7de; padding: .45rem .8rem; font-weight: 900; box-shadow: 0 3px 0 #111a33; }
  .h2h-primary { background: #ffd64a !important; }
  .h2h-screen button { color: #111a33; }
  .h2h-clock, .h2h-hud strong, .h2h-hud-team { border: 2px solid #111a33; border-radius: 999px; background: #fff; padding: .35rem .75rem; }
  .h2h-hud-team { display: inline-flex; align-items: center; gap: .4rem; line-height: 1; }
  .h2h-hud-team small { display: block; color: #64748b; font-size: .6rem; margin-top: .12rem; }
  .h2h-hud-head { width: 2rem; height: 2rem; border-radius: 50%; background: #1b2446 center / cover no-repeat; display: inline-block; flex: 0 0 auto; }
  .h2h-hud-team b { font-weight: 900; }
  .h2h-hud-rival .h2h-hud-head { background-color: #ffd64a; }
  .h2h-meter { width: 88px; height: 13px; border: 2px solid #111a33; border-radius: 999px; overflow: hidden; background: #e5e7eb; }
  .h2h-meter span { display: block; width: calc(var(--p) * 100%); height: 100%; background: linear-gradient(90deg, #1b2446, #ffd64a); }
  .h2h-meter-rival span { background: linear-gradient(90deg, #c2410c, #fee2e2); }
  .h2h-screen { display: grid; place-items: center; overflow: visible; scroll-margin-top: 5rem; padding: clamp(.65rem, 2vw, 1.3rem); background: rgba(251,247,239,.96); color: #111827; text-align: center; border: 4px solid #111a33; border-radius: 1.4rem; box-shadow: 0 8px 0 #111a33; }
  .h2h-game[data-mode="match"] .h2h-screen,
  .h2h-game[data-mode="paused"] .h2h-screen { position: absolute; inset: 0; overflow: auto; }
  .h2h-screen[hidden] { display: none; }
  .h2h-pause { container-type: size; background: rgba(7, 17, 45, .66); backdrop-filter: blur(2px); -webkit-backdrop-filter: blur(2px); color: #fff; }
  .h2h-pause-card { display: grid; justify-items: center; gap: clamp(.3rem, 3cqh, .7rem); }
  .h2h-pause-card p { margin: 0; }
  .h2h-pause-title { font-size: clamp(1.5rem, 16cqh, 3.2rem); font-weight: 1000; line-height: 1; letter-spacing: .04em; text-transform: uppercase; color: #ffd64a; text-shadow: 0 4px 0 #111a33; }
  .h2h-pause-score { font-size: clamp(.95rem, 8cqh, 1.6rem); font-weight: 1000; color: #111a33; background: #fff; border: 2px solid #111a33; border-radius: 999px; padding: .1rem .9rem; font-variant-numeric: tabular-nums; }
  .h2h-pause-actions { display: flex; flex-wrap: wrap; justify-content: center; gap: .5rem; }
  .h2h-pause-hint { max-width: 26rem; font-size: .78rem; font-weight: 700; color: #cbd5e1; }
  @container (max-height: 200px) { .h2h-pause-hint { display: none; } }
  .h2h-select, .h2h-season, .h2h-quick { align-content: start; justify-items: stretch; text-align: left; }
  .h2h-selected { font-weight: 900; }
  .h2h-preview { display: grid; grid-template-columns: 7rem 1fr; gap: .8rem; align-items: center; border: 2px solid #111a33; border-radius: 1.2rem; background: #fff8dc; padding: .6rem; margin: .55rem 0 .8rem; }
  .h2h-preview img { width: 7rem; height: 9rem; object-fit: contain; }
  .h2h-preview-bars { display: grid; gap: .3rem; max-width: 18rem; }
  .h2h-preview-bars span { display: block; height: .45rem; border-radius: 999px; background: linear-gradient(90deg, #1b2446 calc(var(--v) * 100%), #d7dce8 0); }
  .h2h-roster { display: grid; gap: .7rem; overflow: visible; padding-right: .25rem; }
  .h2h-roster h3 { margin: .25rem 0; }
  .h2h-player-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr)); gap: .55rem; }
  .h2h-player-card { display: grid; grid-template-columns: 58px 1fr; gap: .45rem; align-items: center; text-align: left; border: 2px solid #111a33; border-radius: .85rem; background: #fff; padding: .35rem; }
  .h2h-player-card[aria-pressed="true"] { outline: 4px solid #ffd64a; }
  .h2h-player-card img { width: 58px; height: 58px; object-fit: contain; }
  .h2h-player-card small { display: block; color: #475569; }
  .h2h-player-card em { grid-column: 1 / -1; display: grid; grid-template-columns: repeat(3, 1fr); gap: .2rem; }
  .h2h-player-card i { height: .35rem; border-radius: 999px; background: linear-gradient(90deg, #1b2446 calc(var(--v) * 100%), #d7dce8 0); }
  .h2h-actions { display: flex; gap: .55rem; flex-wrap: wrap; justify-content: center; margin-top: .7rem; padding: .4rem 0; }
  .h2h-season-top { display: flex; justify-content: space-between; gap: 1rem; flex-wrap: wrap; align-items: center; }
  .h2h-season-grid { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(14rem, .8fr); gap: .75rem; align-items: start; }
  .h2h-next-card { display: flex; align-items: center; gap: .75rem; min-width: 0; }
  .h2h-next-card img { width: 4.5rem; height: 4.5rem; flex: 0 0 auto; border-radius: 50%; border: 3px solid #111a33; background: var(--next, #ffd64a); object-fit: cover; box-shadow: 0 4px 0 #111a33; }
  .h2h-next-card h2 { margin: 0; font-size: .78rem; letter-spacing: .12em; text-transform: uppercase; color: #64748b; }
  .h2h-next-card p { margin: .1rem 0 0; }
  .h2h-next-round { font-weight: 900; color: #1b2446; }
  .h2h-table-wrap { overflow-x: auto; border: 2px solid #111a33; border-radius: .9rem; background: #fff; }
  .h2h-table { width: 100%; border-collapse: collapse; font-size: .82rem; background: #fff; }
  .h2h-table th { background: #111a33; color: #fff; font-size: .7rem; letter-spacing: .06em; }
  .h2h-table th, .h2h-table :global(td) { border-bottom: 1px solid #e2e8f0; padding: .3rem .38rem; white-space: nowrap; text-align: center; }
  .h2h-table :global(td:nth-child(2)) { text-align: left; font-weight: 800; }
  .h2h-table :global(td:last-child) { font-weight: 900; }
  .h2h-table :global(tr[data-zone="up"] td:first-child) { box-shadow: inset 5px 0 0 #f5b700; }
  .h2h-table :global(tr[data-zone="po"] td:first-child) { box-shadow: inset 5px 0 0 #3b82f6; }
  .h2h-table :global(tr[data-zone="rel"] td:first-child) { box-shadow: inset 5px 0 0 #ef4444; }
  .h2h-table :global(tr[data-seoul="true"]) { background: #fff4c4; font-weight: 900; }
  .h2h-table :global(.h2h-team) { display: inline-flex; align-items: center; gap: .4rem; }
  .h2h-table :global(.h2h-team img) { width: 1.55rem; height: 1.55rem; border-radius: 50%; object-fit: cover; background: var(--c); border: 1.5px solid #111a33; }
  .h2h-table :global(.h2h-team small) { color: #64748b; font-weight: 700; margin-left: .15rem; }
  .h2h-legend { display: flex; flex-wrap: wrap; align-items: center; gap: .3rem .55rem; margin: .45rem 0 0; font-size: .72rem; color: #475569; }
  .h2h-legend span { width: .7rem; height: .7rem; border-radius: .2rem; display: inline-block; margin-right: -.25rem; }
  .h2h-zone-up { background: #f5b700; }
  .h2h-zone-po { background: #3b82f6; }
  .h2h-zone-rel { background: #ef4444; }
  .h2h-fixtures { display: grid; gap: .3rem; max-height: 27rem; overflow: auto; margin: 0; padding: 0; list-style: none; }
  .h2h-fixtures :global(li) { display: grid; grid-template-columns: 2.1rem 1.9rem minmax(0, 1fr) auto; align-items: center; gap: .4rem; border: 2px solid #111a33; border-radius: .8rem; background: #fff; padding: .25rem .45rem; font-size: .82rem; }
  .h2h-fixtures :global(li[data-next="true"]) { background: #fff4c4; box-shadow: 0 3px 0 #111a33; }
  .h2h-fixtures :global(li[data-done="true"]) { color: #64748b; }
  .h2h-fixtures :global(li img) { width: 1.9rem; height: 1.9rem; border-radius: 50%; object-fit: cover; background: var(--c); border: 1.5px solid #111a33; }
  .h2h-fixtures :global(li b) { font-size: .72rem; color: #64748b; }
  .h2h-fixtures :global(li span) { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .h2h-fixtures :global(li em) { font-style: normal; font-weight: 900; display: inline-flex; align-items: center; gap: .3rem; }
  .h2h-fixtures :global(li i) { font-style: normal; display: inline-grid; place-items: center; width: 1.45rem; height: 1.45rem; border-radius: 50%; border: 1.5px solid #111a33; font-weight: 900; font-size: .75rem; color: #111a33; }
  .h2h-fixtures :global(li i[data-r="W"]) { background: #ffd64a; }
  .h2h-fixtures :global(li i[data-r="D"]) { background: #dbeafe; }
  .h2h-fixtures :global(li i[data-r="L"]) { background: #fee2e2; }
  .h2h-quick-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr)); gap: .55rem; width: 100%; }
  .h2h-quick-grid button { display: flex; align-items: center; gap: .5rem; text-align: left; border-radius: 1rem; }
  .h2h-kit-toggle { display: flex; justify-content: center; gap: .5rem; margin-bottom: .65rem; }
  .h2h-kit-toggle button[aria-pressed="true"] { background: #ffd64a; }
  .h2h-mascot-thumb { width: 54px; height: 54px; flex: 0 0 auto; object-fit: cover; border-radius: 50%; border: 2px solid #111a33; }
  .h2h-quick-grid small { display: block; color: #475569; }
  /* Result screen */
  .h2h-result, .h2h-end { position: relative; overflow: hidden; isolation: isolate; align-content: start; gap: .35rem; color: #fff; border-color: #111a33; background: radial-gradient(120% 90% at 50% 0%, var(--glow, #3b4f99) 0%, #111a33 62%); }
  .h2h-result[data-outcome="win"] { --glow: #b8860b; }
  .h2h-result[data-outcome="draw"] { --glow: #5b6b8f; }
  .h2h-result[data-outcome="loss"] { --glow: #3a2a44; }
  .h2h-result > *, .h2h-end > * { position: relative; z-index: 1; margin: 0; }
  .h2h-banner { font-size: clamp(2.1rem, 7vw, 4.2rem); font-weight: 1000; line-height: 1; text-transform: uppercase; letter-spacing: .02em; color: #ffd64a; -webkit-text-stroke: .06em #111a33; paint-order: stroke fill; text-shadow: 0 .09em 0 #111a33; animation: h2h-slam .5s cubic-bezier(.2, 1.5, .4, 1) both; }
  .h2h-result[data-outcome="draw"] .h2h-banner { color: #e2e8f0; }
  .h2h-result[data-outcome="loss"] .h2h-banner { color: #cbd5e1; }
  .h2h-result-meta { font-size: .78rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; color: #cbd5e1; }
  .h2h-scoreline { display: grid; grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr); align-items: center; gap: clamp(.4rem, 3vw, 2rem); width: min(100%, 46rem); margin-top: .35rem !important; }
  .h2h-side { display: grid; justify-items: center; gap: .3rem; margin: 0; min-width: 0; }
  .h2h-side figcaption { font-weight: 900; font-size: clamp(.8rem, 2.2vw, 1.05rem); max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .h2h-avatar { width: clamp(4.2rem, 13vw, 7.5rem); aspect-ratio: 1; border-radius: 50%; border: .28rem solid #fff; background: #1b2446; box-shadow: 0 .35rem 0 rgba(0, 0, 0, .35); overflow: hidden; display: block; }
  .h2h-avatar img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .h2h-avatar-home { background: linear-gradient(160deg, #2c3d7a, #1b2446); animation: h2h-in-l .5s .1s cubic-bezier(.2, 1.3, .4, 1) both; }
  .h2h-avatar-rival { background: var(--rival, #0a8f5b); animation: h2h-in-r .5s .1s cubic-bezier(.2, 1.3, .4, 1) both; }
  .h2h-result[data-outcome="win"] .h2h-avatar-home, .h2h-result[data-outcome="loss"] .h2h-avatar-rival { border-color: #ffd64a; }
  .h2h-goal-mins { min-height: 1.1rem; font-size: .78rem; font-weight: 800; color: #e2e8f0; }
  .h2h-big-score { font-size: clamp(3rem, 12vw, 6.5rem); font-weight: 1000; line-height: .95; color: #fff; -webkit-text-stroke: .05em #111a33; paint-order: stroke fill; text-shadow: 0 .08em 0 rgba(0, 0, 0, .45); white-space: nowrap; font-variant-numeric: tabular-nums; animation: h2h-slam .55s .2s cubic-bezier(.2, 1.4, .4, 1) both; }
  .h2h-result-line { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: .45rem; font-weight: 700; color: #e2e8f0; }
  .h2h-points { display: inline-block; border: 2px solid #111a33; border-radius: 999px; background: #ffd64a; color: #111a33; font-weight: 1000; padding: .15rem .65rem; box-shadow: 0 3px 0 #111a33; }
  .h2h-result[data-outcome="draw"] .h2h-points { background: #e2e8f0; }
  .h2h-result[data-outcome="loss"] .h2h-points { background: #94a3b8; }
  .h2h-stat-rows { display: grid; gap: .3rem; width: min(100%, 30rem); margin-top: .35rem !important; }
  .h2h-stat-row { display: grid; grid-template-columns: 2.4rem 1fr 2.4rem; align-items: center; row-gap: .15rem; font-size: .8rem; }
  .h2h-stat-row b { font-size: 1rem; font-weight: 1000; font-variant-numeric: tabular-nums; }
  .h2h-stat-row span { color: #cbd5e1; font-weight: 800; text-transform: uppercase; letter-spacing: .08em; font-size: .68rem; }
  .h2h-stat-row i { grid-column: 1 / -1; height: .42rem; border-radius: 999px; background: var(--rival, #0a8f5b); overflow: hidden; border: 1px solid rgba(255, 255, 255, .35); }
  .h2h-stat-row em { display: block; height: 100%; width: calc(var(--l) * 100%); background: linear-gradient(90deg, #ffd64a, #f5b700); transition: width .8s .4s ease-out; }
  .h2h-mini { width: min(100%, 26rem); border: 2px solid rgba(255, 255, 255, .5); border-radius: 1rem; background: rgba(255, 255, 255, .08); padding: .45rem .6rem; margin-top: .35rem !important; }
  .h2h-mini[hidden] { display: none; }
  .h2h-mini-head { display: flex; justify-content: space-between; gap: .5rem; margin: 0 0 .3rem; font-size: .72rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; color: #cbd5e1; }
  .h2h-mini-head strong { color: #ffd64a; letter-spacing: .02em; }
  .h2h-mini-head strong[data-dir="down"] { color: #fca5a5; }
  .h2h-mini-head strong[data-dir="same"] { color: #e2e8f0; }
  .h2h-mini-rows { list-style: none; margin: 0; padding: 0; display: grid; gap: .18rem; }
  .h2h-mini-rows :global(li) { display: grid; grid-template-columns: 1.6rem 1.5rem minmax(0, 1fr) 2.2rem; align-items: center; gap: .35rem; border-radius: .55rem; padding: .12rem .3rem; font-size: .8rem; text-align: left; }
  .h2h-mini-rows :global(li[data-seoul="true"]) { background: #ffd64a; color: #111a33; font-weight: 900; animation: h2h-rise .7s .5s cubic-bezier(.2, 1.3, .4, 1) both; }
  .h2h-mini-rows :global(li img) { width: 1.5rem; height: 1.5rem; border-radius: 50%; object-fit: cover; background: var(--c); }
  .h2h-mini-rows :global(li span) { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .h2h-mini-rows :global(li b) { text-align: right; }
  .h2h-big-btn { font-size: 1.1rem; padding: .6rem 1.6rem !important; }
  .h2h-result .h2h-actions, .h2h-end .h2h-actions { margin-top: .45rem; }
  .h2h-confetti { position: absolute !important; inset: 0; z-index: 0 !important; pointer-events: none; overflow: hidden; }
  .h2h-confetti :global(i) { position: absolute; top: -8%; left: var(--x); width: var(--w, .55rem); height: calc(var(--w, .55rem) * 1.6); background: var(--c); border-radius: 2px; opacity: 0; animation: h2h-fall var(--d, 2.6s) var(--delay, 0s) cubic-bezier(.3, .2, .6, 1) forwards; }
  @keyframes h2h-fall { 0% { opacity: 1; transform: translate3d(0, 0, 0) rotate(0); } 85% { opacity: 1; } 100% { opacity: 0; transform: translate3d(var(--dx, 0), 115cqh, 0) rotate(var(--r, 540deg)); } }
  @keyframes h2h-slam { from { transform: scale(1.8); opacity: 0; } to { transform: scale(1); opacity: 1; } }
  @keyframes h2h-in-l { from { transform: translateX(-60%) rotate(-8deg); opacity: 0; } to { transform: none; opacity: 1; } }
  @keyframes h2h-in-r { from { transform: translateX(60%) rotate(8deg); opacity: 0; } to { transform: none; opacity: 1; } }
  @keyframes h2h-rise { from { transform: translateY(1.2rem); } to { transform: none; } }
  .h2h-result, .h2h-end { container-type: inline-size; }

  /* Season end */
  .h2h-end[data-variant="champion"], .h2h-end[data-variant="runnerUp"] { --glow: #b8860b; }
  .h2h-end[data-variant="playoff"] { --glow: #1d4ed8; }
  .h2h-end[data-variant="mid"] { --glow: #3b4f99; }
  .h2h-end[data-variant="relegation"] { --glow: #7f1d1d; }
  .h2h-end-kicker { font-size: .78rem; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; color: #cbd5e1; }
  .h2h-end-title { font-size: clamp(1.8rem, 6vw, 3.6rem); font-weight: 1000; line-height: 1; text-transform: uppercase; color: #ffd64a; -webkit-text-stroke: .05em #111a33; paint-order: stroke fill; text-shadow: 0 .09em 0 #111a33; animation: h2h-slam .55s cubic-bezier(.2, 1.5, .4, 1) both; }
  .h2h-end[data-variant="mid"] .h2h-end-title, .h2h-end[data-variant="relegation"] .h2h-end-title { color: #e2e8f0; }
  .h2h-end-line { max-width: 36rem; color: #e2e8f0; font-weight: 700; }
  .h2h-end-hero { display: flex; align-items: center; justify-content: center; gap: clamp(.4rem, 3vw, 1.5rem); margin-top: .3rem !important; }
  .h2h-end-sticker { height: clamp(6rem, 21vw, 10rem); width: auto; max-width: 42%; object-fit: contain; filter: drop-shadow(0 .5rem 0 rgba(0, 0, 0, .35)); animation: h2h-in-l .6s .15s cubic-bezier(.2, 1.3, .4, 1) both; }
  .h2h-end-trophy { display: none; height: clamp(6rem, 21vw, 10rem); width: auto; filter: drop-shadow(0 .5rem 0 rgba(0, 0, 0, .35)); animation: h2h-slam .6s .35s cubic-bezier(.2, 1.4, .4, 1) both; }
  .h2h-end[data-variant="champion"] .h2h-end-trophy { display: block; }
  .h2h-end-pos { display: grid; justify-items: center; align-self: center; border: 3px solid #111a33; border-radius: 1.2rem; background: #ffd64a; color: #111a33; padding: .4rem .8rem; box-shadow: 0 5px 0 #111a33; animation: h2h-in-r .6s .25s cubic-bezier(.2, 1.3, .4, 1) both; }
  .h2h-end-pos strong { font-size: clamp(1.8rem, 6vw, 3rem); font-weight: 1000; line-height: 1; }
  .h2h-end-pos span { font-size: .75rem; font-weight: 900; text-transform: uppercase; letter-spacing: .08em; }
  .h2h-end[data-variant="playoff"] .h2h-end-pos { background: #bfdbfe; }
  .h2h-end[data-variant="mid"] .h2h-end-pos, .h2h-end[data-variant="relegation"] .h2h-end-pos { background: #e2e8f0; }
  .h2h-end-stats { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: .4rem; width: min(100%, 36rem); margin-top: .4rem !important; }
  .h2h-end-stats div { display: grid; grid-template-columns: minmax(0, 1fr); align-content: center; border: 2px solid rgba(255, 255, 255, .55); border-radius: .9rem; background: rgba(255, 255, 255, .08); padding: .35rem .25rem; min-width: 0; }
  .h2h-end-stats dt { font-size: .64rem; font-weight: 900; letter-spacing: .08em; text-transform: uppercase; color: #cbd5e1; }
  .h2h-end-stats dd { margin: .1rem 0 0; font-size: clamp(.95rem, 3vw, 1.3rem); font-weight: 1000; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .h2h-end-stats dd :global(small) { display: block; overflow: hidden; text-overflow: ellipsis; font-size: .62rem; font-weight: 800; color: #cbd5e1; margin-top: .05rem; }
  .h2h-beaten { width: min(100%, 36rem); margin-top: .35rem !important; }
  .h2h-beaten p { margin: 0 0 .3rem; font-size: .72rem; font-weight: 900; letter-spacing: .1em; text-transform: uppercase; color: #cbd5e1; }
  .h2h-beaten-grid { display: flex; flex-wrap: wrap; justify-content: center; gap: .3rem; }
  .h2h-beaten-grid :global(img) { width: clamp(2.2rem, 9vw, 3rem); height: clamp(2.2rem, 9vw, 3rem); border-radius: 50%; object-fit: cover; background: var(--c); border: 2px solid #fff; box-shadow: 0 3px 0 rgba(0, 0, 0, .35); animation: h2h-slam .4s var(--delay, 0s) cubic-bezier(.2, 1.4, .4, 1) both; }
  .h2h-beaten-grid :global(em) { font-style: normal; color: #e2e8f0; font-weight: 700; }

  /* VS intro */
  .h2h-vs { position: absolute; inset: 0; z-index: 8; container-type: size; display: grid; grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr); grid-template-rows: minmax(0, 1fr) auto auto; align-items: center; column-gap: 2cqw; padding: 5cqh 3cqw 3.5cqh; color: #fff; background: var(--rival, #0a8f5b); overflow: hidden; border: 4px solid #111a33; border-radius: 1.4rem; cursor: pointer; animation: h2h-vs-shake .32s .72s both; }
  .h2h-vs[hidden] { display: none; }
  .h2h-vs::before { content: ""; position: absolute; inset: -2px; background: linear-gradient(160deg, #2a3d80 0%, #1b2446 55%, #111a33 100%); clip-path: polygon(0 0, 59% 0, 41% 100%, 0 100%); animation: h2h-vs-panel .42s cubic-bezier(.2, 1, .3, 1) both; }
  .h2h-vs::after { content: ""; position: absolute; inset: 0; background: repeating-linear-gradient(115deg, rgba(255, 255, 255, .07) 0 2cqw, transparent 2cqw 5cqw), radial-gradient(circle at 50% 45%, rgba(255, 255, 255, .22), transparent 42%); pointer-events: none; }
  .h2h-vs-side { position: relative; z-index: 1; display: grid; justify-items: center; align-content: center; gap: 1.2cqh; min-width: 0; height: 100%; text-align: center; }
  .h2h-vs-left { animation: h2h-vs-in-l .5s .08s cubic-bezier(.2, 1.35, .4, 1) both; }
  .h2h-vs-right { animation: h2h-vs-in-r .5s .16s cubic-bezier(.2, 1.35, .4, 1) both; }
  .h2h-vs-club { font-size: max(.55rem, 4cqh); font-weight: 1000; letter-spacing: .09em; text-transform: uppercase; padding: .6cqh 2cqh; border-radius: 999px; background: rgba(17, 26, 51, .55); border: 1px solid rgba(255, 255, 255, .45); max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .h2h-vs-left img { height: 58cqh; width: auto; max-width: 100%; object-fit: contain; filter: drop-shadow(0 1.6cqh 0 rgba(0, 0, 0, .3)); }
  .h2h-vs-ring { display: block; height: 46cqh; aspect-ratio: 1; border-radius: 50%; border: max(3px, 1.2cqh) solid #fff; background: #fff; overflow: hidden; box-shadow: 0 1.6cqh 0 rgba(0, 0, 0, .3); margin: 6cqh 0; }
  .h2h-vs-ring img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .h2h-vs-side strong { font-size: max(.8rem, 7cqh); font-weight: 1000; line-height: 1.05; text-shadow: 0 .6cqh 0 #111a33; max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .h2h-vs-side small { font-size: max(.6rem, 4.2cqh); font-weight: 800; color: #e2e8f0; max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .h2h-vs-mark { position: relative; z-index: 2; font-size: 30cqh; font-weight: 1000; line-height: 1; color: #ffd64a; -webkit-text-stroke: .07em #111a33; paint-order: stroke fill; text-shadow: 0 .08em 0 rgba(0, 0, 0, .35); font-style: italic; animation: h2h-vs-slam .38s .42s cubic-bezier(.2, 1.6, .4, 1) both; }
  .h2h-vs-meta { position: relative; z-index: 1; grid-column: 1 / -1; justify-self: center; margin: 0; max-width: 100%; border: 2px solid rgba(255, 255, 255, .7); border-radius: 999px; background: rgba(17, 26, 51, .78); padding: .8cqh 3cqh; font-size: max(.62rem, 4.4cqh); font-weight: 900; text-align: center; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; animation: h2h-fade .3s .6s both; }
  .h2h-vs-skip { position: relative; z-index: 1; grid-column: 1 / -1; justify-self: center; margin: 1cqh 0 0; font-size: max(.55rem, 3cqh); font-weight: 700; color: rgba(255, 255, 255, .8); animation: h2h-fade .4s 1s both; }
  @container (max-height: 240px) { .h2h-vs-skip { display: none; } .h2h-vs-club { display: none; } .h2h-vs-ring { margin: 2cqh 0; } }
  @keyframes h2h-vs-panel { from { transform: translateX(-70%); } to { transform: none; } }
  @keyframes h2h-vs-in-l { from { transform: translateX(-120%); opacity: 0; } to { transform: none; opacity: 1; } }
  @keyframes h2h-vs-in-r { from { transform: translateX(120%); opacity: 0; } to { transform: none; opacity: 1; } }
  @keyframes h2h-vs-slam { from { transform: scale(3) rotate(-12deg); opacity: 0; } to { transform: scale(1) rotate(-4deg); opacity: 1; } }
  @keyframes h2h-vs-shake { 0%, 100% { transform: none; } 20% { transform: translate(-1.2%, .8%); } 45% { transform: translate(1%, -.8%); } 70% { transform: translate(-.6%, .4%); } }
  @keyframes h2h-fade { from { opacity: 0; } to { opacity: 1; } }
  @media (prefers-reduced-motion: reduce) {
    .h2h-vs, .h2h-vs::before, .h2h-vs *, .h2h-result *, .h2h-end * { animation: h2h-fade .25s both !important; }
    .h2h-confetti { display: none; }
    .h2h-stat-row em { transition: none; }
  }
  .h2h-touch { display: grid; grid-template-columns: 1fr 1.45fr; gap: .45rem; }
  .h2h-touch > div { display: flex; gap: .35rem; justify-content: space-between; min-width: 0; }
  .h2h-touch button { min-width: 0; width: 100%; min-height: 64px; touch-action: none; background: #111a33; color: #fff; font-size: 1.35rem; padding: .25rem; }
  .h2h-how { margin-top: .8rem; border: 2px solid #111a33; border-radius: 1rem; background: #fbf7ef; color: #111827; padding: .8rem 1rem; }
  @media (hover: hover) and (pointer: fine) {
    .h2h-touch { display: none !important; }
  }
  @media (max-width: 760px) {
    .h2h-game { margin-inline: -0.15rem; }
    .h2h-stage { border-radius: .9rem; }
    .h2h-season-grid { grid-template-columns: 1fr; }
    .h2h-screen { min-height: auto; padding: .75rem; }
    .h2h-player-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .45rem; }
    .h2h-player-card { grid-template-columns: 44px 1fr; border-radius: 1rem; padding: .3rem; font-size: .82rem; }
    .h2h-player-card img { width: 44px; height: 44px; }
    .h2h-hud { height: 44px; gap: .2rem; overflow: hidden; justify-content: space-between; }
    .h2h-hud-team { padding: .12rem .25rem; max-width: 6.4rem; border-width: 1px; gap: .2rem; }
    .h2h-hud-team > span:not(.h2h-hud-head) { display: none; }
    .h2h-hud-head { width: 2rem; height: 2rem; }
    .h2h-clock, .h2h-hud strong { padding: .2rem .42rem; font-size: .9rem; border-width: 1px; }
