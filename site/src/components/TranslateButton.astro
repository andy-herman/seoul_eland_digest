---
import { withBase } from "../lib/paths";

interface Props {
  href: string;
  code: string;
  label: string;
  ariaLabel?: string;
}

const { href, code, label, ariaLabel = `Read in ${label}` } = Astro.props;
---

<a
  href={withBase(href)}
  class="inline-flex items-center gap-2 rounded-full border px-4 py-2 text-sm font-black no-underline transition-colors hover:bg-white"
  style="border-color: color-mix(in srgb, var(--color-gold) 42%, var(--color-rule)); color: var(--color-gold-light);"
  aria-label={ariaLabel}
>
  <span class="text-xs uppercase tracking-[0.18em]" aria-hidden="true">{code}</span>
  <span>{label}</span>
</a>
