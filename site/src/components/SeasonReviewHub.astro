---
// Season Review hub: one card per reviewed player, grouped by position.
// Photo, number and season line come from the official roster feed (same as
// PlayerCard); grade, part and subtitle come from the review article itself.
import { getCollection } from "astro:content";
import { getOfficialRosterWithPhotos } from "../lib/officialRoster";
import { withBase } from "../lib/paths";

interface Props {
  lang?: "en" | "pt";
}

const { lang = "en" } = Astro.props;
const pt = lang === "pt";
const base = pt ? "/pt/articles" : "/articles";

const t = pt
  ? {
      groups: { GK: "Goleiro", DF: "Defensores", MF: "Meio-campistas", FW: "Atacantes" },
      apps: "Jogos",
      goals: "Gols",
      assists: "Assist.",
      minutes: "Min",
      read: "Ler a avaliação",
      grade: "Nota",
      players: "jogadores",
      average: "Distribuição das notas",
    }
  : {
      groups: { GK: "Goalkeeper", DF: "Defenders", MF: "Midfielders", FW: "Forwards" },
      apps: "Apps",
      goals: "Goals",
      assists: "Assists",
      minutes: "Mins",
      read: "Read the review",
      grade: "Grade",
      players: "players",
      average: "Grade spread",
    };

const [articles, roster] = await Promise.all([
  getCollection(pt ? "articlesPt" : "articles"),
  getOfficialRosterWithPhotos(),
]);

const GRADE_RE = pt ? /\*\*Nota até aqui:\s*([A-D])(?:\s+(mais|menos))?\.?\*\*/ : /\*\*Grade so far:\s*([A-D])(?:\s+(plus|minus))?\.?\*\*/;

function groupOf(position: string): keyof typeof t.groups {
  if (/goal/i.test(position)) return "GK";
  if (/defend/i.test(position)) return "DF";
  if (/midfield/i.test(position)) return "MF";
  return "FW";
}

const reviews = articles
  .filter((a) => a.data.series === (pt ? "Avaliação da Temporada" : "Season Review") && a.data.player)
  .map((a) => {
    const player = roster.find((p) => p.slug === a.data.player);
    const m = a.body?.match(GRADE_RE);
    const mod = m?.[2];
    const grade = m ? `${m[1]}${mod === "plus" || mod === "mais" ? "+" : mod === "minus" || mod === "menos" ? "-" : ""}` : undefined;
    const subtitle = a.data.title.replace(/^[^:]*:\s*/, "").split(/,\s*/).slice(1).join(", ");
    const sub = subtitle ? subtitle.charAt(0).toUpperCase() + subtitle.slice(1) : "";
    return { entry: a, player, grade, letter: m?.[1], subtitle: sub, slug: a.id.replace(/\.md$/, "") };
  })
  .filter((r) => r.player)
  .sort((a, b) => a.entry.data.order - b.entry.data.order);

const groups = (Object.keys(t.groups) as (keyof typeof t.groups)[])
  .map((key) => ({
    key,
    label: t.groups[key],
    items: reviews.filter((r) => groupOf(r.player!.englishPosition) === key),
  }))
  .filter((g) => g.items.length > 0);

const PT_POS: Record<string, string> = { Goalkeeper: "Goleiro", Defender: "Defensor", Midfielder: "Meio-campista", Forward: "Atacante", Attacker: "Atacante" };
const posLabel = (pos: string) => (pt ? PT_POS[pos] ?? pos : pos);

const gradeOrder = ["A+", "A", "A-", "B+", "B", "B-", "C+", "C", "C-", "D"];
const spread = gradeOrder
  .map((g) => ({ g, n: reviews.filter((r) => r.grade === g).length }))
  .filter((x) => x.n > 0);

const gradeStyle = (letter?: string) =>
  letter === "A"
    ? "background: var(--color-gold); color: var(--color-navy-deep);"
    : letter === "B"
      ? "background: #fff; color: var(--color-navy-deep);"
      : "background: color-mix(in srgb, white 18%, var(--color-navy)); color: #fff;";
---

<div class="season-review-hub">
  <div class="mb-8 flex flex-wrap items-center gap-2">
    <span class="text-xs font-black uppercase tracking-[0.16em]" style="color: var(--color-muted);">{t.average}</span>
    {spread.map((s) => (
      <span class="metadata-chip">{s.g} × {s.n}</span>
    ))}
    <span class="metadata-chip">{reviews.length} {t.players}</span>
  </div>

  {groups.map((g) => (
    <section class="mb-12">
      <h2 class="mb-5 text-2xl font-black uppercase tracking-tight sm:text-3xl">{g.label}</h2>
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {g.items.map((r) => {
          const p = r.player!;
          const s = p.stats ?? {};
          return (
            <a
              href={withBase(`${base}/${r.slug}`)}
              class="group flex flex-col overflow-hidden rounded-2xl border no-underline transition duration-200 hover:-translate-y-1 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[var(--color-gold)]"
              style="background-color: var(--color-surface); border-color: var(--color-rule);"
            >
              <div class="relative h-60 overflow-hidden" style="background: linear-gradient(145deg, var(--color-blue) 0%, var(--color-navy-deep) 75%);">
                <div class="absolute left-4 top-3 text-6xl font-black leading-none opacity-25" style="color: var(--color-gold);">
                  {p.backNumber}
                </div>
                <img
                  src={p.photoUrl}
                  alt={p.englishName}
                  class="absolute bottom-0 right-0 h-60 w-full object-contain object-bottom transition-transform duration-300 group-hover:scale-105"
                  loading="lazy"
                />
                {r.grade && (
                  <div class="absolute right-3 top-3 flex h-14 w-14 flex-col items-center justify-center rounded-xl shadow-lg" style={gradeStyle(r.letter)} aria-label={`${t.grade} ${r.grade}`}>
                    <span class="text-[0.5rem] font-black uppercase tracking-[0.14em] opacity-70">{t.grade}</span>
                    <span class="text-2xl font-black leading-none">{r.grade}</span>
                  </div>
                )}
                {r.entry.data.part && (
                  <span class="metadata-chip absolute bottom-3 left-3" style="background: var(--color-navy-deep); color: #fff;">{r.entry.data.part}</span>
                )}
              </div>
              <div class="flex flex-1 flex-col p-5">
                <h3 class="text-xl font-black tracking-tight">{p.englishName}</h3>
                <p class="mt-0.5 text-sm" style="color: var(--color-muted);">
                  {p.korName} · #{p.backNumber} · {posLabel(p.englishPosition)}
                </p>
                {r.subtitle && (
                  <p class="mt-3 text-sm font-semibold leading-6" style="color: var(--color-link);">{r.subtitle}</p>
                )}
                <dl class="mt-4 grid grid-cols-4 gap-2 text-center">
                  {[
                    { l: t.apps, v: s.appearances },
                    { l: t.goals, v: s.goals },
                    { l: t.assists, v: s.assists },
                    { l: t.minutes, v: s.minutes },
                  ].map((c) => (
                    <div class="rounded-lg border px-1 py-2" style="border-color: var(--color-rule); background-color: color-mix(in srgb, white 5%, transparent);">
                      <dt class="text-[0.55rem] font-black uppercase tracking-[0.1em]" style="color: var(--color-muted);">{c.l}</dt>
                      <dd class="mt-1 text-lg font-black leading-none">{c.v ?? 0}</dd>
                    </div>
                  ))}
                </dl>
                <span class="mt-auto pt-4 text-xs font-black uppercase tracking-[0.14em]" style="color: var(--color-gold-light);">
                  {t.read} →
                </span>
              </div>
            </a>
          );
        })}
      </div>
    </section>
  ))}
</div>
