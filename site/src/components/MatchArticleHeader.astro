---
import ResultBadge from "./ResultBadge.astro";
import TranslateButton from "./TranslateButton.astro";
import KoreanButton from "./KoreanButton.astro";
import { getTeamInitials, getTeamLogo } from "../lib/teamLogos";
import { withBase } from "../lib/paths";
import { dateLocale, type Locale } from "../lib/i18n";
import { koTeam } from "../lib/teamNamesKo";

interface Props {
  slug: string;
  season: number;
  round: number;
  date: Date;
  opponent: string;
  venue: "home" | "away" | "neutral";
  result: string;
  locale?: Locale;
}

const { slug, season, round, date, opponent, venue, result, locale = "en" } = Astro.props;
const isPortuguese = locale === "pt";
const isKorean = locale === "ko";
const opponentLogo = getTeamLogo(opponent);
const opponentInitials = getTeamInitials(opponent);
const displayOpponent = isKorean ? koTeam(opponent, "short") : opponent;
const resultLetter = result.trim().charAt(0).toUpperCase();
const scorePart = result.trim().slice(1).trim();
const [elandScore = "—", opponentScore = "—"] = scorePart.split("-").map((part) => part.trim());
const shortDateLabel = date.toLocaleDateString(dateLocale[locale], {
  weekday: "short",
  month: "short",
  day: "numeric",
  year: "numeric",
  timeZone: "UTC",
});

const labels = isKorean
  ? {
      season: "시즌",
      round: "라운드",
      venue: venue === "home" ? "홈" : venue === "away" ? "원정" : "중립",
      resultText: resultLetter === "W" ? "승리" : resultLetter === "D" ? "무승부" : resultLetter === "L" ? "패배" : "경기 종료",
      matchup: venue === "away" ? `${displayOpponent} 원정` : venue === "home" ? `${displayOpponent}전` : `${displayOpponent} 중립 경기`,
      eyebrow: "경기 리뷰",
      deck: "전술 포인트, 선수 이야기, 승격 레이스 흐름을 팬의 시선으로 정리한 리뷰.",
      toggleHref: `/rounds/${slug}`,
      toggleCode: "EN",
      toggleLabel: "영어",
      toggleAria: "영어로 보기",
      toggleHelp: "이 리뷰를 영어로 읽기.",
      crestAlt: "서울 이랜드 FC 엠블럼",
      opponentAlt: `${displayOpponent} 엠블럼`,
      fullTime: "경기 종료",
      homeName: "서울 이랜드 FC",
    }
  : isPortuguese
    ? {
      season: "Temporada",
      round: "Rodada",
      venue: venue === "home" ? "Casa" : venue === "away" ? "Fora" : "Neutro",
      resultText: resultLetter === "W" ? "Vitória" : resultLetter === "D" ? "Empate" : resultLetter === "L" ? "Derrota" : "Fim de jogo",
      matchup: venue === "away" ? `fora contra ${opponent}` : venue === "home" ? `contra ${opponent}` : `em campo neutro contra ${opponent}`,
      eyebrow: "Resumo da partida",
      deck: "Um relato para torcedores, com notas táticas, contexto dos jogadores e leitura da briga pelo acesso.",
      toggleHref: `/rounds/${slug}`,
      toggleCode: "EN",
      toggleLabel: "Inglês",
      toggleAria: "Ler em inglês",
      toggleHelp: "Ler este relato em inglês.",
      crestAlt: "Escudo do Seoul E-Land FC",
      opponentAlt: `Logo do ${opponent}`,
      fullTime: "Fim de jogo",
      homeName: "Seoul E-Land FC",
    }
  : {
      season: "Season",
      round: "Round",
      venue: venue === "home" ? "Home" : venue === "away" ? "Away" : "Neutral",
      resultText: resultLetter === "W" ? "Seoul win" : resultLetter === "D" ? "Draw" : resultLetter === "L" ? "Seoul loss" : "Full time",
      matchup: venue === "home" ? `vs ${opponent}` : venue === "away" ? `at ${opponent}` : `v ${opponent}`,
      eyebrow: "Match digest",
      deck: "A supporter-focused match report with tactical notes, player context, and the wider promotion-race read.",
      toggleHref: `/pt/rounds/${slug}`,
      toggleCode: "PT",
      toggleLabel: "Português",
      toggleAria: "Read in Portuguese",
      toggleHelp: "Read this match report in Portuguese.",
      crestAlt: "Seoul E-Land FC crest",
      opponentAlt: `${opponent} logo`,
      fullTime: "Full time",
      homeName: "Seoul E-Land FC",
    };
---

<header class="supporter-panel not-prose mb-3 rounded-[1.5rem] sm:mb-4 sm:rounded-[2rem]">
  <div class="relative min-w-0 p-5 sm:p-8 lg:p-10">
    <div class="article-meta-stack">
      <p class="article-meta-primary">{isKorean ? `K리그2 · ${season}시즌 · ${round}라운드` : `K League 2 · ${labels.season} ${season} · ${labels.round} ${round}`}</p>
      <p class="article-meta-secondary">
        <span>{labels.venue}</span>
        <span aria-hidden="true">·</span>
        <time datetime={date.toISOString()}>{shortDateLabel}</time>
      </p>
    </div>

    <div class="match-mobile-summary mt-4 sm:hidden">
      <div class="match-mobile-team">
        <img src={withBase("/assets/crest.png")} alt={labels.crestAlt} class="match-mobile-logo" />
        <span>{labels.homeName}</span>
      </div>
      <div class="match-mobile-center">
        <ResultBadge result={result} size="sm" locale={locale} />
        <p>{elandScore}-{opponentScore}</p>
        <span>{labels.resultText}</span>
      </div>
      <div class="match-mobile-team match-mobile-team-right">
        {opponentLogo ? (
          <img src={opponentLogo} alt={labels.opponentAlt} class="match-mobile-logo" />
        ) : (
          <span class="match-mobile-logo match-mobile-initials">{opponentInitials}</span>
        )}
        <span>{displayOpponent}</span>
      </div>
    </div>

    <div class="scoreboard-grid mt-6 hidden min-w-0 sm:mt-8 sm:grid">
      <div class="scoreboard-team scoreboard-home min-w-0 rounded-2xl border p-3 text-center sm:rounded-3xl sm:p-5" style="background-color: color-mix(in srgb, white 6%, transparent); border-color: var(--color-rule);">
        <img src={withBase("/assets/crest.png")} alt={labels.crestAlt} class="scoreboard-team-logo mx-auto h-14 w-14 object-contain min-[380px]:h-16 min-[380px]:w-16 sm:h-20 sm:w-20" />
        <p class="scoreboard-team-name mt-2 text-[0.68rem] font-black uppercase tracking-[0.08em] min-[380px]:text-xs sm:mt-3 sm:text-sm sm:tracking-[0.14em]" style="color: var(--color-link);">{labels.homeName}</p>
      </div>

      <div class="scoreboard-center text-center">
        <ResultBadge result={result} size="sm" locale={locale} />
        <div class="mt-3 flex items-baseline justify-center gap-1.5 font-black tabular-nums min-[380px]:gap-2 sm:mt-4 sm:gap-3">
          <span class="text-4xl leading-none min-[380px]:text-5xl sm:text-7xl" style="color: var(--color-ink);">{elandScore}</span>
          <span class="text-2xl min-[380px]:text-3xl sm:text-4xl" style="color: var(--color-gold-light);">–</span>
          <span class="text-4xl leading-none min-[380px]:text-5xl sm:text-7xl" style="color: var(--color-ink);">{opponentScore}</span>
        </div>
        <p class="mt-2 text-[0.64rem] font-black uppercase tracking-[0.12em] min-[380px]:text-xs min-[380px]:tracking-[0.18em] sm:mt-3" style="color: var(--color-gold-light);">
          {labels.resultText} · {labels.fullTime}
        </p>
      </div>

      <div class="scoreboard-team scoreboard-away min-w-0 rounded-2xl border p-3 text-center sm:rounded-3xl sm:p-5" style="background-color: color-mix(in srgb, white 6%, transparent); border-color: var(--color-rule);">
        <span class="scoreboard-team-logo mx-auto flex h-14 w-14 items-center justify-center rounded-2xl bg-white p-2 min-[380px]:h-16 min-[380px]:w-16 sm:h-20 sm:w-20 sm:p-3">
          {opponentLogo ? (
            <img src={opponentLogo} alt={labels.opponentAlt} class="h-full w-full object-contain" />
          ) : (
            <span class="text-xl font-black" style="color: var(--color-navy);">{opponentInitials}</span>
          )}
        </span>
        <p class="scoreboard-team-name mt-2 text-[0.68rem] font-black uppercase tracking-[0.08em] min-[380px]:text-xs sm:mt-3 sm:text-sm sm:tracking-[0.14em]" style="color: var(--color-link);">{displayOpponent}</p>
      </div>
    </div>

    <div class="mt-6 min-w-0 max-w-3xl sm:mt-8">
      <p class="eyebrow">{labels.eyebrow}</p>
      <h1 class="mt-3 text-[1.85rem] font-black tracking-tight min-[380px]:text-[2.05rem] sm:text-5xl">
        {isKorean ? `${round}라운드` : `${labels.round} ${round}`}: {labels.matchup}
      </h1>
      <p class="mt-4 hidden text-base leading-7 sm:block sm:text-lg sm:leading-8" style="color: var(--color-link);">
        {labels.deck}
      </p>
      <div class="mt-5 flex flex-wrap items-center gap-3">
        <TranslateButton href={labels.toggleHref} code={labels.toggleCode} label={labels.toggleLabel} ariaLabel={labels.toggleAria} />
        {isKorean && (
          <TranslateButton href={`/pt/rounds/${slug}`} code="PT" label="포르투갈어" ariaLabel="포르투갈어로 보기" />
        )}
        {!isKorean && <KoreanButton />}
        <p class="hidden text-sm font-semibold sm:block" style="color: var(--color-muted);">
          {labels.toggleHelp}
        </p>
      </div>
    </div>
  </div>
</header>

<div
  class="match-sticky-strip not-prose sticky top-14 z-30 mb-6 rounded-2xl border px-4 py-2.5 backdrop-blur sm:top-[4.75rem] sm:mb-8 sm:px-6 sm:py-3"
  style="background-color: color-mix(in srgb, var(--color-navy-deep) 92%, transparent); border-color: color-mix(in srgb, var(--color-gold) 24%, var(--color-rule));"
  aria-label={`${isKorean ? `${round}라운드` : `${labels.round} ${round}`}, ${labels.matchup}, ${labels.resultText} ${elandScore}-${opponentScore}`}
>
  <div class="flex min-w-0 items-center gap-3">
    <span class="shrink-0 text-xs font-black uppercase tracking-[0.16em]" style="color: var(--color-gold-light);">
      {isKorean ? `${round}라운드` : `${labels.round} ${round}`}
    </span>
    <ResultBadge result={result} size="sm" locale={locale} />
    <span class="min-w-0 flex-1 truncate text-sm font-black" style="color: var(--color-ink);">
      {labels.matchup}
    </span>
    <span class="hidden shrink-0 text-xs font-bold uppercase tracking-[0.12em] sm:inline" style="color: var(--color-muted);">
      {shortDateLabel}
    </span>
  </div>
</div>
