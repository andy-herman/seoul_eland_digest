---
import ResultBadge from "./ResultBadge.astro";
import { getTeamInitials, getTeamLogo } from "../lib/teamLogos";
import { withBase } from "../lib/paths";

interface Props {
  href: string;
  round: number;
  date: Date;
  opponent: string;
  venue: "home" | "away" | "neutral";
  result: string;
  deck?: string;
  locale?: "en" | "pt";
}

const { href, round, date, opponent, venue, result, deck, locale = "en" } = Astro.props;
const isPortuguese = locale === "pt";
const opponentLogo = getTeamLogo(opponent);
const opponentInitials = getTeamInitials(opponent);
const dateLabel = date.toLocaleDateString(isPortuguese ? "pt-BR" : "en-US", {
  weekday: "short",
  month: "short",
  day: "numeric",
  year: "numeric",
  timeZone: "UTC",
});
const score = result.trim().slice(1).trim();
const venueLabel = isPortuguese
  ? venue === "home"
    ? "Casa"
    : venue === "away"
      ? "Fora"
      : "Neutro"
  : venue === "home"
    ? "Home"
    : venue === "away"
      ? "Away"
      : "Neutral";
const labels = isPortuguese
  ? {
      eyebrow: "Última partida",
      round: "Rodada",
      read: "Ler o resumo mais recente",
      homeAlt: "Escudo do Seoul E-Land FC",
      opponentAlt: `Logo do ${opponent}`,
    }
  : {
      eyebrow: "Latest match",
      round: "Round",
      read: "Read the latest digest",
      homeAlt: "Seoul E-Land FC crest",
      opponentAlt: `${opponent} logo`,
    };
---

<a
  href={withBase(href)}
  class="latest-match-card group min-w-0 overflow-hidden rounded-[1.25rem] border p-4 no-underline transition duration-200 hover:-translate-y-1 sm:rounded-[1.5rem] sm:p-5"
  style="background: color-mix(in srgb, white 8%, transparent); border-color: color-mix(in srgb, var(--color-gold) 26%, var(--color-rule)); box-shadow: 0 16px 36px color-mix(in srgb, black 18%, transparent);"
>
  <div class="flex items-center justify-between gap-4">
    <div class="min-w-0">
      <p class="eyebrow">{labels.eyebrow}</p>
      <p class="latest-match-meta mt-1 text-sm font-bold uppercase tracking-[0.14em]" style="color: var(--color-muted);">
        {labels.round} {round} · {dateLabel}
      </p>
    </div>
    <ResultBadge result={result} size="sm" />
  </div>

  <div class="latest-score-strip mt-5 hidden grid-cols-[minmax(0,1fr)_auto_minmax(0,1fr)] items-center gap-2 text-center min-[380px]:gap-3 sm:mt-6 sm:grid">
    <div class="latest-team flex flex-col items-center gap-2">
      <span class="latest-team-logo flex h-12 w-12 items-center justify-center rounded-2xl bg-white p-2 min-[380px]:h-14 min-[380px]:w-14 sm:h-16 sm:w-16">
        <img src={withBase("/assets/crest.png")} alt={labels.homeAlt} class="h-full w-full object-contain" loading="lazy" />
      </span>
      <span class="latest-team-name text-xs font-black" style="color: var(--color-link);">Seoul E-Land</span>
    </div>
    <div>
      <p class="latest-score text-3xl font-black tabular-nums leading-none min-[380px]:text-[2.15rem] sm:text-4xl" style="color: var(--color-ink);">{score}</p>
      <p class="mt-2 text-[0.68rem] font-bold uppercase tracking-[0.14em] min-[380px]:text-xs min-[380px]:tracking-[0.16em]" style="color: var(--color-gold-light);">{venueLabel}</p>
    </div>
    <div class="latest-team flex flex-col items-center gap-2">
      <span class="latest-team-logo flex h-12 w-12 items-center justify-center rounded-2xl bg-white p-2 min-[380px]:h-14 min-[380px]:w-14 sm:h-16 sm:w-16">
        {opponentLogo ? (
          <img src={opponentLogo} alt={labels.opponentAlt} class="h-full w-full object-contain" loading="lazy" />
        ) : (
          <span class="font-black" style="color: var(--color-navy);">{opponentInitials}</span>
        )}
      </span>
      <span class="latest-team-name max-w-full text-xs font-black" style="color: var(--color-link);">{opponent}</span>
    </div>
  </div>

  <div class="latest-mobile-summary mt-4 sm:hidden">
    <div class="latest-mobile-team">
      <img src={withBase("/assets/crest.png")} alt={labels.homeAlt} class="latest-mobile-logo" loading="lazy" />
      <span>Seoul E-Land</span>
    </div>
    <p class="latest-mobile-score">{score}</p>
    <div class="latest-mobile-team latest-mobile-team-right">
      {opponentLogo ? (
        <img src={opponentLogo} alt={labels.opponentAlt} class="latest-mobile-logo" loading="lazy" />
      ) : (
        <span class="latest-mobile-logo latest-mobile-initials">{opponentInitials}</span>
      )}
      <span>{opponent}</span>
    </div>
  </div>

  {deck && (
    <p class="mt-6 hidden border-t pt-5 text-sm leading-7 sm:block" style="border-color: var(--color-rule); color: var(--color-link);">
      {deck}
    </p>
  )}
  <p class="mt-5 text-sm font-black sm:mt-5" style="color: var(--color-gold-light);">
    {labels.read} <span class="inline-block transition-transform group-hover:translate-x-1">→</span>
  </p>
</a>
