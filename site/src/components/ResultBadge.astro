---
interface Props {
  result: string; // e.g. "W 2-1", "D 0-0", "L 1-3"
  size?: "sm" | "md";
}

const { result, size = "md" } = Astro.props;
const letter = result.trim().charAt(0).toUpperCase();
const score = result.trim().slice(1).trim();

const colorVar =
  letter === "W"
    ? "var(--color-result-win)"
    : letter === "D"
      ? "var(--color-result-draw)"
      : letter === "L"
        ? "var(--color-result-loss)"
        : "var(--color-muted)";

const label =
  letter === "W" ? "Win" : letter === "D" ? "Draw" : letter === "L" ? "Loss" : "Result";
const padding = size === "sm" ? "px-2 py-1 text-[0.7rem]" : "px-3 py-1.5 text-sm";
---

<span
  class={`inline-flex items-center gap-1.5 rounded-full border font-black uppercase tracking-[0.12em] ${padding}`}
  style={`background-color: color-mix(in srgb, ${colorVar} 15%, transparent); border-color: color-mix(in srgb, ${colorVar} 38%, transparent); color: ${colorVar};`}
  aria-label={`${label} ${score}`}
>
  <span>{letter}</span>
  <span class="tabular-nums tracking-normal">{score}</span>
</span>
