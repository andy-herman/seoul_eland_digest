---
import { stripBase, withBase } from "../lib/paths";

interface Props {
  locale?: "en" | "pt";
}

const { locale = "en" } = Astro.props;
const isPortuguese = locale === "pt";
const pathname = stripBase(Astro.url.pathname);
const englishNavItems = [
  { href: "/", label: "Rounds" },
  { href: "/matches", label: "Matches" },
  { href: "/previews", label: "Previews" },
  { href: "/tracker", label: "Tracker" },
  { href: "/korean-cup", label: "Korean Cup", mobileLabel: "Cup" },
  { href: "/guides", label: "Guides" },
  { href: "/players", label: "Squad" },
];
const navItems = isPortuguese
  ? [
      { href: "/pt/", label: "Rodadas" },
      { href: "/pt/matches", label: "Partidas" },
      { href: "/pt/previews", label: "Prévias" },
      { href: "/pt/tracker", label: "Rastreador", mobileLabel: "Dados" },
      { href: "/pt/korean-cup", label: "Copa da Coreia", mobileLabel: "Copa" },
      { href: "/pt/guides", label: "Guias" },
      { href: "/players", label: "Elenco" },
    ]
  : englishNavItems;

function isActive(href: string) {
  if (href === "/") {
    return pathname === "/" || pathname.startsWith("/rounds");
  }
  if (href === "/pt/") {
    return pathname === "/pt/" || pathname.startsWith("/pt/rounds");
  }
  return pathname.startsWith(href);
}
---

<header class="sticky top-0 z-40 border-b backdrop-blur-xl" style="background-color: color-mix(in srgb, var(--color-navy-deep) 92%, transparent); border-color: color-mix(in srgb, var(--color-gold) 16%, var(--color-rule));">
  <!-- The single-row switch waits for md. At sm the nav still wraps to its own
       row, and letting the roomier gap and vertical padding arrive there made
       the sticky header 135px tall. Horizontal padding still steps at sm so the
       logo stays aligned with the main content column. -->
  <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-1.5 px-3 py-1.5 sm:px-6 md:flex-nowrap md:gap-5 md:py-3">
    <a href={withBase("/")} class="flex items-center gap-3 no-underline" aria-label="Seoul E-Land Digest home">
      <span class="flex h-9 w-[4.6rem] items-center justify-center rounded-xl bg-white px-1.5 shadow-lg shadow-black/20 min-[380px]:h-10 min-[380px]:w-20 min-[380px]:px-2 lg:h-11 lg:w-24 lg:px-3">
        <img src={withBase("/assets/logo-official.svg")} alt="Seoul E-Land FC" class="h-7 w-auto min-[380px]:h-8" />
      </span>
      <!-- The wordmark used to appear at sm, the exact width where the nav also
           starts sharing the row with the logo. Those two together were the
           640px pinch. It waits for lg now, alongside the nav's own sizing. -->
      <span class="hidden lg:block leading-tight">
        <span class="block text-sm font-black uppercase tracking-[0.18em]" style="color: var(--color-ink);">Digest</span>
        <span class="block text-[0.68rem] font-bold uppercase tracking-[0.2em]" style="color: var(--color-gold-light);">
          {isPortuguese ? "Publicação de torcida" : "Supporter publication"}
        </span>
      </span>
    </a>

    <div class="order-3 w-full min-w-0 rounded-full border p-0.5 md:order-none md:w-auto md:p-1" style="background-color: color-mix(in srgb, white 6%, transparent); border-color: color-mix(in srgb, var(--color-gold) 18%, var(--color-rule));">
    <!-- Type and padding stay compact until lg. Bumping them at sm made the nav
         overflow harder on a tablet than on a phone, and it keeps 44px tap
         targets on touch-sized screens rather than shrinking them at 640px. -->
    <nav class="flex min-w-0 snap-x items-center gap-0.5 overflow-x-auto text-[0.7rem] font-bold lg:gap-1 lg:text-sm" style="scrollbar-width: none;" data-scroll-fade>
      {navItems.map((item) => (
        <a
          href={withBase(item.href)}
          class={`inline-flex min-h-11 shrink-0 snap-start items-center rounded-full px-2 py-1.5 no-underline transition-colors min-[380px]:px-2.5 lg:min-h-0 lg:px-3.5 lg:py-2 ${isActive(item.href) ? "bg-white shadow-sm" : "text-[var(--color-link)] hover:text-white"}`}
          style={isActive(item.href) ? "color: var(--color-navy);" : undefined}
          aria-label={item.label}
          aria-current={isActive(item.href) ? "page" : undefined}
        >
          {item.mobileLabel ? (
            <>
              <span class="min-[430px]:hidden">{item.mobileLabel}</span>
              <span class="hidden min-[430px]:inline">{item.label}</span>
            </>
          ) : (
            item.label
          )}
        </a>
      ))}
    </nav>
    </div>
  </div>
</header>
