---
import { stripBase, withBase } from "../lib/paths";

const pathname = stripBase(Astro.url.pathname);
const navItems = [
  { href: "/", label: "Rounds" },
  { href: "/players", label: "Squad" },
  { href: "/about", label: "About" },
];

function isActive(href: string) {
  return href === "/" ? pathname === "/" : pathname.startsWith(href);
}
---

<header class="sticky top-0 z-40 border-b backdrop-blur-xl" style="background-color: color-mix(in srgb, var(--color-navy-deep) 88%, transparent); border-color: color-mix(in srgb, var(--color-gold) 20%, var(--color-rule));">
  <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-3 px-4 py-3 sm:flex-nowrap sm:gap-5 sm:px-6">
    <a href={withBase("/")} class="flex items-center gap-3 no-underline" aria-label="Seoul E-Land Digest home">
      <span class="flex h-10 w-20 items-center justify-center rounded-xl bg-white px-2 shadow-lg shadow-black/20 sm:h-11 sm:w-24 sm:px-3">
        <img src={withBase("/assets/logo-official.svg")} alt="Seoul E-Land FC" class="h-8 w-auto" />
      </span>
      <span class="hidden sm:block leading-tight">
        <span class="block text-sm font-black uppercase tracking-[0.18em]" style="color: var(--color-ink);">Digest</span>
        <span class="block text-[0.68rem] font-bold uppercase tracking-[0.2em]" style="color: var(--color-gold-light);">Supporter publication</span>
      </span>
    </a>

    <nav class="flex max-w-full items-center gap-1 overflow-x-auto rounded-full border p-1 text-xs font-bold sm:text-sm" style="background-color: color-mix(in srgb, white 7%, transparent); border-color: var(--color-rule);">
      {navItems.map((item) => (
        <a
          href={withBase(item.href)}
          class={`shrink-0 rounded-full px-3 py-2 no-underline transition-colors sm:px-4 ${isActive(item.href) ? "bg-white shadow-sm" : "text-[var(--color-link)] hover:text-white"}`}
          style={isActive(item.href) ? "color: var(--color-navy);" : undefined}
        >
          {item.label}
        </a>
      ))}
    </nav>
  </div>
</header>
