---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import TranslateButton from "../../../components/TranslateButton.astro";
import PlayerCard from "../../../components/PlayerCard.astro";
import { withBase } from "../../../lib/paths";
import { getOfficialRosterWithPhotos } from "../../../lib/officialRoster";

export async function getStaticPaths() {
  const [articles, enArticles, roster] = await Promise.all([
    getCollection("articlesPt"),
    getCollection("articles"),
    getOfficialRosterWithPhotos(),
  ]);
  const enIds = new Set(enArticles.map((a) => a.id));

  return articles.map((entry) => ({
    params: { slug: entry.id.replace(/\.md$/, "") },
    props: {
      entry,
      hasEnglish: enIds.has(entry.id),
      player: entry.data.player ? roster.find((p) => p.slug === entry.data.player) : undefined,
      series: articles
        .filter((a) => a.data.series === entry.data.series)
        .sort((a, b) => a.data.order - b.data.order || a.data.date.getTime() - b.data.date.getTime())
        .map((a) => ({ slug: a.id.replace(/\.md$/, ""), title: a.data.title, part: a.data.part, player: a.data.player })),
    },
  }));
}

const { entry, hasEnglish, player, series } = Astro.props;
const { Content } = await render(entry);
const slug = entry.id.replace(/\.md$/, "");
const seriesIndex = series.findIndex((s) => s.slug === slug);
const prevPart = seriesIndex > 0 ? series[seriesIndex - 1] : undefined;
const nextPart = seriesIndex >= 0 && seriesIndex < series.length - 1 ? series[seriesIndex + 1] : undefined;
const shortTitle = (t: string) => t.replace(/^[^:]*:\s*/, "");

const dateStr = entry.data.date.toLocaleDateString("pt-BR", {
  year: "numeric",
  month: "long",
  day: "numeric",
  timeZone: "UTC",
});
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  ogType="article"
  publishedDate={entry.data.date.toISOString()}
  lang="pt"
>
  <article class="editorial-shell preview-article mx-auto">
    <header class="mb-8 border-b pb-6" style="border-color: #e7dac9;">
      <p class="text-xs font-black uppercase tracking-[0.18em]" style="color: var(--color-gold);">
        {entry.data.series}{entry.data.part ? ` · ${entry.data.part}` : ""}
      </p>
      <h1 class="mt-3 text-3xl font-black leading-tight tracking-tight sm:text-5xl" style="color: var(--color-navy);">
        {entry.data.title}
      </h1>
      <p class="mt-4 max-w-3xl text-base font-semibold leading-7" style="color: var(--color-editorial-muted);">
        {entry.data.description}
      </p>
      <div class="mt-5 flex flex-wrap items-center gap-2">
        <span class="metadata-chip" style="background: #fff; color: var(--color-navy);">{dateStr}</span>
        {hasEnglish && (
          <TranslateButton
            href={`/articles/${slug}`}
            code="EN"
            label="English"
            ariaLabel="Read this article in English"
          />
        )}
      </div>
    </header>

    {player && (
      <div class="mb-8">
        <PlayerCard player={player} lang="pt" />
      </div>
    )}

    <div class="prose-eland digest-body preview-body">
      <Content />
    </div>
    {entry.data.part && series.length > 1 && (
      <nav class="series-nav mt-12 border-t pt-6" style="border-color: #e7dac9;" aria-label="Nesta série">
        <div class="grid gap-3 sm:grid-cols-2">
          {prevPart ? (
            <a href={withBase(`/pt/articles/${prevPart.slug}`)} class="block rounded-xl border p-4 no-underline" style="border-color: #e7dac9; background: #fff;">
              <span class="block text-xs font-black uppercase tracking-[0.14em]" style="color: var(--color-gold);">← Anterior{prevPart.part ? ` · ${prevPart.part}` : ""}</span>
              <span class="mt-1 block text-sm font-bold leading-snug" style="color: var(--color-navy);">{shortTitle(prevPart.title)}</span>
            </a>
          ) : <span />}
          {nextPart && (
            <a href={withBase(`/pt/articles/${nextPart.slug}`)} class="block rounded-xl border p-4 text-right no-underline" style="border-color: #e7dac9; background: #fff;">
              <span class="block text-xs font-black uppercase tracking-[0.14em]" style="color: var(--color-gold);">Próximo{nextPart.part ? ` · ${nextPart.part}` : ""} →</span>
              <span class="mt-1 block text-sm font-bold leading-snug" style="color: var(--color-navy);">{shortTitle(nextPart.title)}</span>
            </a>
          )}
        </div>
        {entry.data.player && (
          <a href={withBase("/pt/articles/season-review")} class="mt-4 inline-block text-xs font-black uppercase tracking-[0.14em] no-underline" style="color: var(--color-gold);">Todos os cartões →</a>
        )}
        <details class="mt-4">
          <summary class="cursor-pointer text-xs font-black uppercase tracking-[0.14em]" style="color: var(--color-editorial-muted);">Nesta série: {series.length}</summary>
          <ol class="mt-3 grid gap-1 text-sm sm:grid-cols-2" style="color: var(--color-navy);">
            {series.map((s) => (
              <li>
                {s.slug === slug
                  ? <strong>{s.part ? `${s.part}. ` : ""}{shortTitle(s.title).split(",")[0]}</strong>
                  : <a href={withBase(`/pt/articles/${s.slug}`)} style="color: var(--color-navy);">{s.part ? `${s.part}. ` : ""}{shortTitle(s.title).split(",")[0]}</a>}
              </li>
            ))}
          </ol>
        </details>
      </nav>
    )}
  </article>

  <nav class="mx-auto mt-10 max-w-5xl border-t pt-6" style="border-color: var(--color-rule);">
    <a href={withBase("/pt/articles")} class="text-sm font-black no-underline transition-colors hover:text-white" style="color: var(--color-gold-light);">
      ← Todos os artigos
    </a>
  </nav>
</BaseLayout>
