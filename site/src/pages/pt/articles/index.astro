---
import { getCollection } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import TranslateButton from "../../../components/TranslateButton.astro";
import { withBase } from "../../../lib/paths";

const articles = (await getCollection("articlesPt")).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime() || a.data.order - b.data.order,
);

const seriesOrder: string[] = [];
const bySeries = new Map<string, typeof articles>();
for (const article of articles) {
  const key = article.data.series;
  if (!bySeries.has(key)) {
    bySeries.set(key, []);
    seriesOrder.push(key);
  }
  bySeries.get(key)!.push(article);
}

const dateFormatter = new Intl.DateTimeFormat("pt-BR", {
  day: "numeric",
  month: "short",
  year: "numeric",
  timeZone: "UTC",
});
---

<BaseLayout
  title="Artigos do Seoul E-Land"
  description="Leituras longas sobre o Seoul E-Land FC: avaliações da temporada jogador a jogador, a carta semanal Rumo à K1 sobre a corrida pelo acesso, e reportagens especiais."
  lang="pt"
>
  <section class="supporter-panel mb-8 rounded-[1.5rem] sm:mb-10 sm:rounded-[2rem]">
    <div class="relative p-5 sm:p-8 lg:p-10">
      <p class="eyebrow">Seoul E-Land FC</p>
      <h1 class="mt-3 text-[2.35rem] font-black uppercase leading-none tracking-tight sm:text-6xl">
        Artigos
      </h1>
      <p class="mt-4 max-w-2xl text-[0.95rem] leading-6 sm:text-lg sm:leading-8" style="color: var(--color-link);">
        As leituras longas. Uma avaliação da temporada de 2026 jogador a jogador, um de cada vez. A carta semanal Rumo à K1 sobre quem os rivais enfrentam e o que isso faz com a chance do Seoul de terminar em segundo. Especiais quando a história pede espaço.
      </p>
      <p class="hero-meta-line mt-4 text-sm font-black uppercase tracking-[0.14em]" style="color: var(--color-gold-light);">
        {articles.length} {articles.length === 1 ? "artigo" : "artigos"}
      </p>
      <div class="hero-cta-row mt-4 flex flex-wrap items-center gap-3 sm:mt-7">
        <TranslateButton href="/articles" code="EN" label="English" ariaLabel="Read the articles in English" />
      </div>
    </div>
  </section>

  {seriesOrder.map((series) => (
    <section aria-label={series} class="mb-10">
      <h2 class="mb-4 text-xs font-black uppercase tracking-[0.2em]" style="color: var(--color-gold-light);">{series}</h2>
      <div class="grid gap-4">
        {bySeries.get(series)!.map((article) => (
          <a
            href={withBase(`/pt/articles/${article.id.replace(/\.md$/, "")}`)}
            class="group block rounded-2xl border p-5 no-underline transition duration-200 hover:-translate-y-0.5 sm:p-6"
            style="background: color-mix(in srgb, white 6%, transparent); border-color: color-mix(in srgb, var(--color-gold) 16%, var(--color-rule));"
          >
            <div class="flex flex-wrap items-center gap-2">
              {article.data.part && <span class="metadata-chip">{article.data.part}</span>}
              <span class="metadata-chip">{dateFormatter.format(article.data.date)}</span>
            </div>
            <h3 class="mt-3 text-2xl font-black leading-tight tracking-tight transition-colors group-hover:text-white sm:text-3xl">
              {article.data.title}
            </h3>
            <p class="mt-2 max-w-3xl text-sm font-bold leading-6" style="color: var(--color-link);">
              {article.data.description}
            </p>
            <p class="mt-4 text-sm font-black uppercase tracking-[0.14em]" style="color: var(--color-gold-light);">
              Ler →
            </p>
          </a>
        ))}
      </div>
    </section>
  ))}
</BaseLayout>
