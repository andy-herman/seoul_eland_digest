---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import DigestCard from "../../components/DigestCard.astro";
import LatestMatchCard from "../../components/LatestMatchCard.astro";
import TranslateButton from "../../components/TranslateButton.astro";
import { getDigestDeck } from "../../lib/digestDeck";

const digests = await getCollection("digestsPt");
digests.sort(
  (a, b) =>
    b.data.season - a.data.season || b.data.round - a.data.round,
);

const seasons = [...new Set(digests.map((d) => d.data.season))].sort(
  (a, b) => b - a,
);
const latestDigest = digests[0];
const currentSeason = seasons[0];
const currentSeasonDigests = currentSeason
  ? digests.filter((d) => d.data.season === currentSeason)
  : [];
const wins = currentSeasonDigests.filter((d) => d.data.result.trim().startsWith("W")).length;
const draws = currentSeasonDigests.filter((d) => d.data.result.trim().startsWith("D")).length;
const losses = currentSeasonDigests.filter((d) => d.data.result.trim().startsWith("L")).length;
const latestHref = latestDigest ? `/pt/rounds/${latestDigest.id.replace(/\.md$/, "")}` : "#";
const heroStatsLabel = currentSeason
  ? `Temporada ${currentSeason} · ${digests.length} relatos · ${wins}-${draws}-${losses}`
  : `${digests.length} relatos`;
const deckFallback = "Relatos de jogo, notas dos jogadores e uma leitura direta sobre o que cada resultado significa para o Seoul E-Land.";
---

<BaseLayout
  title="Seoul E-Land Digest em Português"
  description="Cobertura em português do Seoul E-Land FC para torcedores."
  lang="pt"
>
  <section class="supporter-panel home-hero mb-8 rounded-[1.5rem] sm:mb-10 sm:rounded-[2rem]">
    <div class="relative grid min-w-0 gap-6 p-5 sm:gap-8 sm:p-8 lg:grid-cols-[1.15fr_0.85fr] lg:p-10">
      <div class="flex min-w-0 flex-col justify-center">
        <p class="eyebrow">Publicação independente para torcedores</p>
        <h1 class="mt-3 max-w-3xl text-[2.08rem] font-black uppercase leading-[0.95] tracking-tight min-[380px]:text-[2.45rem] sm:text-6xl lg:text-7xl">
          Seoul E-Land Digest
        </h1>
        <p class="mt-4 max-w-2xl text-[0.95rem] leading-6 sm:text-lg sm:leading-8" style="color: var(--color-link);">
          Relatos em português para torcedores do Seoul E-Land: resumos de rodada, temas táticos, contexto dos jogadores e uma leitura clara da briga pelo acesso.
        </p>
        <p class="hero-meta-line mt-4 text-sm font-black uppercase tracking-[0.14em]" style="color: var(--color-gold-light);">
          {heroStatsLabel}
        </p>
        <div class="hero-cta-row mt-4 flex flex-wrap items-center gap-3 sm:mt-7">
          <TranslateButton href="/" code="EN" label="English" ariaLabel="Read the English archive" />
        </div>
      </div>

      {latestDigest && (
        <LatestMatchCard
          href={latestHref}
          round={latestDigest.data.round}
          date={latestDigest.data.date}
          opponent={latestDigest.data.opponent}
          venue={latestDigest.data.venue}
          result={latestDigest.data.result}
          deck={getDigestDeck(latestDigest.body, deckFallback)}
          locale="pt"
        />
      )}
    </div>
  </section>

  {seasons.map((season) => {
    const seasonDigests = digests.filter((d) => d.data.season === season);
    return (
      <section class="mb-12" aria-labelledby={`pt-season-${season}`}>
        <div class="mb-5 flex flex-wrap items-end justify-between gap-3">
          <div>
            <p class="eyebrow">Arquivo de rodadas</p>
            <h2 id={`pt-season-${season}`} class="mt-2 text-3xl font-black tracking-tight">Temporada {season}</h2>
          </div>
          <p class="text-sm font-bold uppercase tracking-[0.14em]" style="color: var(--color-muted);">
            {seasonDigests.length} relatos de partidas
          </p>
        </div>
        <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
          {seasonDigests.map((d) => (
            <DigestCard
              href={`/pt/rounds/${d.id.replace(/\.md$/, "")}`}
              round={d.data.round}
              date={d.data.date}
              opponent={d.data.opponent}
              venue={d.data.venue}
              result={d.data.result}
              locale="pt"
            />
          ))}
        </div>
      </section>
    );
  })}

  {digests.length === 0 && (
    <div class="rounded-2xl border p-6" style="background-color: color-mix(in srgb, white 8%, transparent); border-color: var(--color-rule);">
      <p class="font-black">Ainda não há resumos publicados.</p>
      <p class="mt-2 text-sm" style="color: var(--color-muted);">
        Volte depois da próxima partida do Seoul E-Land.
      </p>
    </div>
  )}
</BaseLayout>
