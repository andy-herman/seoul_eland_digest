---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import TranslateButton from "../../components/TranslateButton.astro";
import PlayerCard from "../../components/PlayerCard.astro";
import { withBase } from "../../lib/paths";
import { getOfficialRosterWithPhotos } from "../../lib/officialRoster";

export async function getStaticPaths() {
  const [articles, ptArticles, roster] = await Promise.all([
    getCollection("articles"),
    getCollection("articlesPt"),
    getOfficialRosterWithPhotos(),
  ]);
  const ptIds = new Set(ptArticles.map((a) => a.id));

  return articles.map((entry) => ({
    params: { slug: entry.id.replace(/\.md$/, "") },
    props: {
      entry,
      hasPortuguese: ptIds.has(entry.id),
      player: entry.data.player ? roster.find((p) => p.slug === entry.data.player) : undefined,
    },
  }));
}

const { entry, hasPortuguese, player } = Astro.props;
const { Content } = await render(entry);
const slug = entry.id.replace(/\.md$/, "");

const dateStr = entry.data.date.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
  timeZone: "UTC",
});
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  ogType="article"
  publishedDate={entry.data.date.toISOString()}
>
  <article class="editorial-shell preview-article mx-auto">
    <header class="mb-8 border-b pb-6" style="border-color: #e7dac9;">
      <p class="text-xs font-black uppercase tracking-[0.18em]" style="color: var(--color-gold);">
        {entry.data.series}{entry.data.part ? ` · ${entry.data.part}` : ""}
      </p>
      <h1 class="mt-3 text-3xl font-black leading-tight tracking-tight sm:text-5xl" style="color: var(--color-navy);">
        {entry.data.title}
      </h1>
      <p class="mt-4 max-w-3xl text-base font-semibold leading-7" style="color: var(--color-editorial-muted);">
        {entry.data.description}
      </p>
      <div class="mt-5 flex flex-wrap items-center gap-2">
        <span class="metadata-chip" style="background: #fff; color: var(--color-navy);">{dateStr}</span>
        {hasPortuguese && (
          <TranslateButton
            href={`/pt/articles/${slug}`}
            code="PT"
            label="Português"
            ariaLabel="Ler este artigo em português"
          />
        )}
      </div>
    </header>

    {player && (
      <div class="mb-8">
        <PlayerCard player={player} lang="en" />
      </div>
    )}

    <div class="prose-eland digest-body preview-body">
      <Content />
    </div>
  </article>

  <nav class="mx-auto mt-10 max-w-5xl border-t pt-6" style="border-color: var(--color-rule);">
    <a href={withBase("/articles")} class="text-sm font-black no-underline transition-colors hover:text-white" style="color: var(--color-gold-light);">
      ← All articles
    </a>
  </nav>
</BaseLayout>
