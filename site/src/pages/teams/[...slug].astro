---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getTeamProfiles, type TeamProfile } from "../../lib/teamProfiles";
import { withBase } from "../../lib/paths";

export function getStaticPaths() {
  return getTeamProfiles().map((team) => ({
    params: { slug: team.slug },
    props: { team },
  }));
}

const { team } = Astro.props as { team: TeamProfile };
---

<BaseLayout
  title={`${team.name} — Seoul E-Land Digest`}
  description={`${team.name} context for Seoul E-Land supporters.`}
>
  <article class="mx-auto max-w-4xl">
    <header class="supporter-panel overflow-hidden rounded-[2rem]">
      <div class="relative grid gap-6 p-6 sm:p-8 md:grid-cols-[auto_1fr] lg:p-10">
        <span class="flex h-24 w-24 items-center justify-center rounded-3xl bg-white p-4 shadow-lg sm:h-28 sm:w-28">
          {team.logo ? (
            <img src={team.logo} alt={`${team.name} logo`} class="h-full w-full object-contain" />
          ) : (
            <span class="text-2xl font-black" style="color: var(--color-navy);">{team.shortName.slice(0, 2).toUpperCase()}</span>
          )}
        </span>
        <div class="min-w-0">
          <p class="eyebrow">{team.category === "competition" ? "Competition guide" : "Opponent guide"}</p>
          <h1 class="mt-3 break-words text-4xl font-black uppercase tracking-tight sm:text-5xl">{team.name}</h1>
          <div class="mt-5 flex flex-wrap gap-2">
            <span class="metadata-chip">{team.location}</span>
            <span class="metadata-chip">{team.category === "competition" ? "League context" : "K League opponent"}</span>
          </div>
        </div>
      </div>
    </header>

    <section class="editorial-shell mx-auto mt-8">
      <div class="prose-eland digest-body mx-auto">
        <h2>Why this matters for Seoul E-Land</h2>
        <p>{team.summary}</p>
        <blockquote>{team.fanNote}</blockquote>
        <h2>Fan context</h2>
        <p>
          This page gives English-speaking Seoul E-Land supporters a quick reference point when {team.shortName}
          comes up in match reports, previews, or the promotion-race picture.
        </p>
      </div>
    </section>
  </article>

  <nav class="mx-auto mt-10 max-w-4xl border-t pt-6" style="border-color: var(--color-rule);">
    <a href={withBase("/")} class="text-sm font-black no-underline transition-colors hover:text-white" style="color: var(--color-gold-light);">
      ← Back to rounds
    </a>
  </nav>
</BaseLayout>
