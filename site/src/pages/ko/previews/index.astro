---
import BaseLayout from "../../../layouts/BaseLayout.astro"; import TranslateButton from "../../../components/TranslateButton.astro"; import { fixtures } from "../../../data/matches"; import { withBase } from "../../../lib/paths"; import { getPreMatchPreviews } from "../../../lib/prematchPreviews"; import { koTeam } from "../../../lib/teamNamesKo";
const previews=getPreMatchPreviews("ko").sort((a,b)=>{const as=a.data.kind==="season"?1:0; const bs=b.data.kind==="season"?1:0; if(as!==bs)return bs-as; return Number(b.data.round||0)-Number(a.data.round||0);}); const nextMatch=[...fixtures].sort((a,b)=>a.round-b.round).find(m=>m.result==="TBD"); const fixtureByRound=new Map(fixtures.map(m=>[m.round,m])); const dateFmt=new Intl.DateTimeFormat("ko-KR",{weekday:"short",month:"long",day:"numeric",year:"numeric",timeZone:"UTC"}); const formatDate=(date?:string)=>date?dateFmt.format(new Date(`${date}T00:00:00Z`)):"날짜 미정"; const venueLabel=(round:number)=>{const f=fixtureByRound.get(round); if(!f)return undefined; return f.venue==="home"?"홈":f.venue==="away"?"원정":"중립";};
---
<BaseLayout title="서울 이랜드 프리뷰" description="서울 이랜드 FC 한국어 프리뷰: 상대 분석, 예상 선발, 전술 키, 모델 전망." lang="ko"><section class="supporter-panel mb-8 rounded-[1.5rem] sm:mb-10 sm:rounded-[2rem]"><div class="relative p-5 sm:p-8 lg:p-10"><p class="eyebrow">서울 이랜드 FC</p><h1 class="mt-3 text-[2.35rem] font-black leading-none tracking-tight sm:text-6xl">프리뷰</h1><p class="mt-4 max-w-2xl text-[0.95rem] leading-6 sm:text-lg sm:leading-8" style="color:var(--color-link);">상대 분석, 예상 선발 라인업, 전술 키, 모델 전망을 경기 전에 정리합니다.</p><p class="hero-meta-line mt-4 text-sm font-black" style="color:var(--color-gold-light);">프리뷰 {previews.length}편</p><div class="hero-cta-row mt-4 flex flex-wrap items-center gap-3 sm:mt-7"><TranslateButton href="/previews" code="EN" label="영어" /><TranslateButton href="/pt/previews" code="PT" label="포르투갈어" /></div></div></section><section aria-label="프리뷰 목록" class="grid gap-4">{previews.map((preview)=>{const isSeason=preview.data.kind==="season"; const round=Number(preview.data.round||0); const isNext=!isSeason && nextMatch?.round===round; const venue=venueLabel(round); return <a href={withBase(`/ko/previews/${preview.slug}`)} class="group block rounded-2xl border p-5 no-underline transition duration-200 hover:-translate-y-0.5 sm:p-6" style={`background:${isNext?"color-mix(in srgb, var(--color-gold) 12%, var(--color-surface))":"color-mix(in srgb, white 6%, transparent)"};border-color:color-mix(in srgb,var(--color-gold) ${isNext?"40%":"16%"},var(--color-rule));`}><div class="flex flex-wrap items-center gap-2">{isSeason ? <><span class="metadata-chip">{preview.data.label || "시즌 프리뷰"}</span>{preview.data.round_range && <span class="metadata-chip">{preview.data.round_range}</span>}</> : <><span class="metadata-chip">{preview.data.round || "TBD"}라운드</span>{preview.data.opponent && <span class="metadata-chip">{koTeam(preview.data.opponent,"short")}</span>}{venue && <span class="metadata-chip">{venue}</span>}<span class="metadata-chip">{formatDate(preview.data.date)}</span>{isNext && <span class="inline-flex rounded-full border px-3 py-1 text-xs font-black" style="border-color:color-mix(in srgb,var(--color-gold) 45%,var(--color-rule));color:var(--color-gold-light);">다음 경기</span>}</>}</div><h2 class="mt-3 text-2xl font-black leading-tight tracking-tight transition-colors group-hover:text-white sm:text-3xl">{preview.title}</h2><p class="mt-2 max-w-3xl text-sm font-bold leading-6" style="color:var(--color-link);">{preview.description}</p><p class="mt-4 text-sm font-black" style="color:var(--color-gold-light);">프리뷰 보기 →</p></a>})}</section>{previews.length===0 && <p class="rounded-2xl border p-6 font-black" style="border-color:var(--color-rule);">아직 한국어 프리뷰가 없습니다.</p>}</BaseLayout>
