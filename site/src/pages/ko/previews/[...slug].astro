---
import BaseLayout from "../../../layouts/BaseLayout.astro"; import TranslateButton from "../../../components/TranslateButton.astro"; import { withBase } from "../../../lib/paths"; import { getPreMatchPreviews, renderPreviewMarkdown, type PreMatchPreview } from "../../../lib/prematchPreviews"; import { koTeam } from "../../../lib/teamNamesKo";
export async function getStaticPaths(){ const previews=getPreMatchPreviews("ko"); const enSlugs=new Set(getPreMatchPreviews("en").map(p=>p.slug)); const ptSlugs=new Set(getPreMatchPreviews("pt").map(p=>p.slug)); return previews.map(preview=>({params:{slug:preview.slug},props:{preview,hasEnglish:enSlugs.has(preview.slug),hasPortuguese:ptSlugs.has(preview.slug)}}));}
const { preview, hasEnglish, hasPortuguese }=Astro.props as {preview:PreMatchPreview;hasEnglish:boolean;hasPortuguese:boolean}; const previewHtml=renderPreviewMarkdown(preview.body,preview); const isSeason=preview.data.kind==="season";
---
<BaseLayout title={preview.title} description={preview.description} lang="ko" ogType="article" publishedDate={preview.data.date ? `${preview.data.date}T00:00:00Z`:undefined}><article class="editorial-shell preview-article mx-auto"><header class="mb-8 border-b pb-6" style="border-color:#e7dac9;"><p class="text-xs font-black" style="color:var(--color-gold);">{isSeason ? `시즌 프리뷰 · ${preview.data.label || "후반기"}` : `경기 프리뷰 · ${preview.data.round || "TBD"}라운드`}</p><h1 class="mt-3 text-3xl font-black leading-tight tracking-tight sm:text-5xl" style="color:var(--color-navy);">{preview.title}</h1><p class="mt-4 max-w-3xl text-base font-semibold leading-7" style="color:var(--color-editorial-muted);">{preview.description}</p><div class="mt-5 flex flex-wrap items-center gap-2">{isSeason ? <span class="metadata-chip" style="background:#fff;color:var(--color-navy);">라운드 {preview.data.round_range || "18-34"}</span> : <><span class="metadata-chip" style="background:#fff;color:var(--color-navy);">상대: {preview.data.opponent ? koTeam(preview.data.opponent,"short") : "미정"}</span><span class="metadata-chip" style="background:#fff;color:var(--color-navy);">{preview.data.date || "날짜 미정"}</span></>}{hasEnglish && <TranslateButton href={`/previews/${preview.slug}`} code="EN" label="영어" />}{hasPortuguese && <TranslateButton href={`/pt/previews/${preview.slug}`} code="PT" label="포르투갈어" />}</div></header><div class="prose-eland digest-body preview-body" set:html={previewHtml} /></article><nav class="mx-auto mt-10 max-w-5xl border-t pt-6" style="border-color:var(--color-rule);"><a href={withBase("/ko/previews")} class="text-sm font-black no-underline transition-colors hover:text-white" style="color:var(--color-gold-light);">← 모든 프리뷰</a></nav></BaseLayout>
