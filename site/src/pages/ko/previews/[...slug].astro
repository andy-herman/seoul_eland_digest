---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import TranslateButton from "../../../components/TranslateButton.astro";
import { withBase } from "../../../lib/paths";
import { koTeam } from "../../../lib/teamNamesKo";
import { formatDate } from "../../../lib/i18n";
import {
  getPreMatchPreviews,
  renderPreviewMarkdown,
  type PreMatchPreview,
} from "../../../lib/prematchPreviews";

export async function getStaticPaths() {
  const previews = getPreMatchPreviews("ko");
  const enSlugs = new Set(getPreMatchPreviews("en").map((preview) => preview.slug));
  const ptSlugs = new Set(getPreMatchPreviews("pt").map((preview) => preview.slug));

  return previews.map((preview) => ({
    params: { slug: preview.slug },
    props: { preview, hasEnglish: enSlugs.has(preview.slug), hasPortuguese: ptSlugs.has(preview.slug) },
  }));
}

interface Props {
  preview: PreMatchPreview;
  hasEnglish: boolean;
  hasPortuguese: boolean;
}

const { preview, hasEnglish, hasPortuguese } = Astro.props;
const previewHtml = renderPreviewMarkdown(preview.body, preview);
const isSeason = preview.data.kind === "season";
---

<BaseLayout
  title={preview.title}
  description={preview.description}
  lang="ko"
  ogType="article"
  publishedDate={preview.data.date ? `${preview.data.date}T00:00:00Z` : undefined}
>
  <article class="editorial-shell preview-article mx-auto">
    <header class="mb-8 border-b pb-6" style="border-color: #e7dac9;">
      <p class="text-xs font-black uppercase tracking-[0.18em]" style="color: var(--color-gold);">
        {isSeason ? `시즌 프리뷰 · ${preview.data.label || "2라운드 로빈"}` : `경기 프리뷰 · ${preview.data.round || "TBD"}라운드`}
      </p>
      <h1 class="mt-3 text-3xl font-black leading-tight tracking-tight sm:text-5xl" style="color: var(--color-navy);">
        {preview.title}
      </h1>
      <p class="mt-4 max-w-3xl text-base font-semibold leading-7" style="color: var(--color-editorial-muted);">
        {preview.description}
      </p>
      <div class="mt-5 flex flex-wrap items-center gap-2">
        {isSeason ? (
          <span class="metadata-chip" style="background: #fff; color: var(--color-navy);">{preview.data.round_range || "18-34"}라운드</span>
        ) : (
          <>
            <span class="metadata-chip" style="background: #fff; color: var(--color-navy);">상대: {preview.data.opponent ? koTeam(preview.data.opponent) : "미정"}</span>
            <span class="metadata-chip" style="background: #fff; color: var(--color-navy);">{preview.data.date ? formatDate(preview.data.date, "ko", { weekday: "short" }) : "날짜 미정"}</span>
          </>
        )}
        {hasEnglish && (
          <TranslateButton
            href={`/previews/${preview.slug}`}
            code="EN"
            label="영어"
            ariaLabel="영어로 읽기"
          />
        )}
        {hasPortuguese && (
          <TranslateButton href={`/pt/previews/${preview.slug}`} code="PT" label="포르투갈어" ariaLabel="포르투갈어로 읽기" />
        )}
      </div>
    </header>

    <div class="prose-eland digest-body preview-body" set:html={previewHtml} />
  </article>

  <nav class="mx-auto mt-10 max-w-5xl border-t pt-6" style="border-color: var(--color-rule);">
    <a href={withBase("/ko/previews")} class="text-sm font-black no-underline transition-colors hover:text-white" style="color: var(--color-gold-light);">
      ← 모든 프리뷰
    </a>
  </nav>
</BaseLayout>
