---
import { safeGetCollection } from "../../../lib/safeContent";
import { getCollection } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import TranslateButton from "../../../components/TranslateButton.astro";
import { getOfficialRosterWithPhotos, type OfficialPlayerWithPhoto } from "../../../lib/officialRoster";
import { getKoreanNationality, getKoreanPosition } from "../../../lib/playerLocalisation";
import { fixtures, type MatchFixture } from "../../../data/matches";
import { withBase } from "../../../lib/paths";

export async function getStaticPaths() {
  const players = await getOfficialRosterWithPhotos();
  const notes = await getCollection("players");
  return players.map((player) => ({ params: { slug: player.slug }, props: { player, entry: notes.find((note) => note.id.replace(/\.md$/, "").replace(/ /g, "-").toLowerCase() === player.slug) } }));
}
const { player, entry } = Astro.props as { player: OfficialPlayerWithPhoto; entry?: Awaited<ReturnType<typeof getCollection<"players">>>[number] };
const position = getKoreanPosition(player.position);
const nationality = getKoreanNationality(player.nationality);
const birthday = player.birthday ? new Date(player.birthday).toLocaleDateString("ko-KR", { year: "numeric", month: "long", day: "numeric" }) : undefined;
const stats = player.stats ?? {};
const teamMatches = fixtures.filter((match: MatchFixture) => match.result && match.result !== "TBD").length;
const hasStats = stats.appearances != null || stats.goals != null || stats.assists != null;
const statCards = [
  { label: "경기", value: stats.appearances, sub: teamMatches ? `${teamMatches}경기 중` : undefined },
  { label: "득점", value: stats.goals },
  { label: "도움", value: stats.assists },
  { label: "출전 시간", value: stats.minutes?.toLocaleString("ko-KR"), sub: "추가시간 포함" },
].filter((card) => card.value != null);
function getMentions(body?: string) {
  if (!body) return [];
  return [...body.matchAll(/\[\[(2026-R\d+_Seoul_E-Land_Digest)\]\]\s*-\s*Round\s+(\d+),\s*([0-9-]+)/g)].map((match) => ({ id: match[1], round: match[2], date: new Date(`${match[3]}T12:00:00Z`).toLocaleDateString("ko-KR", { month: "long", day: "numeric", year: "numeric", timeZone: "UTC" }), href: withBase(`/rounds/${match[1].toLowerCase()}`) }));
}
const mentions = getMentions(entry?.body);
---
<BaseLayout lang="ko" title={`${player.korName} · 서울 이랜드`} description={`${player.korName}, 서울 이랜드의 ${position}입니다.`}>
  <article class="mx-auto max-w-5xl"><header class="supporter-panel overflow-hidden rounded-[2rem]"><div class="relative grid gap-6 p-6 sm:p-8 md:grid-cols-[0.85fr_1.15fr] lg:p-10"><div class="relative min-h-72 overflow-hidden rounded-[1.5rem] border sm:min-h-80" style="background: linear-gradient(145deg, var(--color-blue) 0%, var(--color-navy-deep) 76%); border-color: var(--color-rule);"><div class="absolute left-5 top-5 text-8xl font-black leading-none opacity-25" style="color: var(--color-gold);">{player.backNumber}</div><img src={player.photoUrl} alt={`${player.korName} 사진`} class="absolute bottom-0 right-0 h-full w-full object-contain object-bottom" /></div><div class="flex min-w-0 flex-col justify-center"><p class="eyebrow">서울 이랜드 선수 프로필</p><h1 class="mt-3 break-words text-4xl font-black tracking-tight sm:text-6xl">{player.korName}</h1><p class="mt-2 text-2xl font-bold" style="color: var(--color-gold-light);">{player.englishName}</p><div class="mt-6 flex flex-wrap gap-2"><span class="metadata-chip">#{player.backNumber}</span><span class="metadata-chip">{position}</span><span class="metadata-chip">{nationality}</span></div><dl class="mt-7 grid gap-4 text-sm min-[380px]:grid-cols-2 sm:grid-cols-3"><div class="rounded-2xl border p-4" style="background-color: color-mix(in srgb, white 8%, transparent); border-color: var(--color-rule);"><dt class="font-black" style="color: var(--color-muted);">신장</dt><dd class="mt-2 text-xl font-black">{player.height ? `${player.height} cm` : "-"}</dd></div><div class="rounded-2xl border p-4" style="background-color: color-mix(in srgb, white 8%, transparent); border-color: var(--color-rule);"><dt class="font-black" style="color: var(--color-muted);">체중</dt><dd class="mt-2 text-xl font-black">{player.weight ? `${player.weight} kg` : "-"}</dd></div><div class="rounded-2xl border p-4" style="background-color: color-mix(in srgb, white 8%, transparent); border-color: var(--color-rule);"><dt class="font-black" style="color: var(--color-muted);">생년월일</dt><dd class="mt-2 text-xl font-black">{birthday ?? "-"}</dd></div></dl><div class="mt-6 flex flex-wrap gap-2"><TranslateButton href={`/players/${player.slug}`} code="EN" label="영어" /><TranslateButton href={`/pt/players/${player.slug}`} code="PT" label="포르투갈어" /></div></div></div></header>{hasStats && <section class="mt-8" aria-label={`${player.korName} 시즌 기록`}><div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1"><h2 class="text-2xl font-black tracking-tight">{stats.season ?? new Date().getFullYear()}시즌</h2><p class="text-xs font-black" style="color: var(--color-muted);">K리그2 · 구단 공식 기록</p></div><dl class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-4">{statCards.map((card) => <div class="rounded-2xl border p-4" style="background-color: color-mix(in srgb, white 8%, transparent); border-color: var(--color-rule);"><dt class="text-xs font-black" style="color: var(--color-muted);">{card.label}</dt><dd class="mt-2 text-3xl font-black leading-none">{card.value}</dd>{card.sub && <p class="mt-1.5 text-xs font-bold" style="color: var(--color-muted);">{card.sub}</p>}</div>)}</dl></section>}<section class="editorial-shell mx-auto mt-8"><div class="prose-eland digest-body mx-auto"><h2>팬을 위한 메모</h2><p>{player.korName}은 현재 서울 이랜드 1군 선수단의 {position}입니다. 이 페이지는 공식 프로필 데이터와 시즌 중 라운드 리뷰에서의 언급을 모았습니다.</p>{mentions.length > 0 ? <><h2>최근 언급</h2><ul>{mentions.map((mention) => <li><a href={mention.href}>{mention.round}라운드</a> - {mention.date}</li>)}</ul></> : <p>아직 이 선수에 대한 별도 라운드 언급이 정리되지 않았습니다.</p>}</div></section></article><nav class="mx-auto mt-10 max-w-5xl border-t pt-6" style="border-color: var(--color-rule);"><a href={withBase("/ko/players")} class="text-sm font-black no-underline transition-colors hover:text-white" style="color: var(--color-gold-light);">← 선수단으로 돌아가기</a></nav>
</BaseLayout>
