---
import { getCollection, render } from "astro:content";
import { safeGetCollection } from "../../../lib/safeContent";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import TranslateButton from "../../../components/TranslateButton.astro";
import { withBase } from "../../../lib/paths";

export async function getStaticPaths() {
  const guides = await safeGetCollection("guidesKo");
  const enIds = new Set((await getCollection("guides")).map((guide) => guide.id));
  const ptIds = new Set((await getCollection("guidesPt")).map((guide) => guide.id));

  return guides.map((entry) => ({
    params: { slug: entry.id.replace(/\.md$/, "") },
    props: { entry, hasEnglish: enIds.has(entry.id), hasPortuguese: ptIds.has(entry.id) },
  }));
}

const { entry, hasEnglish, hasPortuguese } = Astro.props;
const { Content } = await render(entry);
const slug = entry.id.replace(/\.md$/, "");

const dateStr = entry.data.date.toLocaleDateString("ko-KR", {
  year: "numeric",
  month: "long",
  timeZone: "UTC",
});

const categoryKo = (category: string) =>
  ({
    "The Club": "구단",
    Watching: "시청",
    Matchday: "경기일",
    "The League": "리그",
    Players: "선수",
  })[category] ?? category;
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  lang="ko"
  ogType="article"
  publishedDate={entry.data.date.toISOString()}
>
  <article class="editorial-shell preview-article mx-auto">
    <header class="mb-8 border-b pb-6" style="border-color: #e7dac9;">
      <p class="text-xs font-black uppercase tracking-[0.18em]" style="color: var(--color-gold);">
        가이드 · {categoryKo(entry.data.category)}
      </p>
      <h1 class="mt-3 text-3xl font-black leading-tight tracking-tight sm:text-5xl" style="color: var(--color-navy);">
        {entry.data.title}
      </h1>
      <p class="mt-4 max-w-3xl text-base font-semibold leading-7" style="color: var(--color-editorial-muted);">
        {entry.data.description}
      </p>
      <div class="mt-5 flex flex-wrap items-center gap-2">
        <span class="metadata-chip" style="background: #fff; color: var(--color-navy);">업데이트 {dateStr}</span>
        {hasEnglish && (
          <TranslateButton
            href={`/guides/${slug}`}
            code="EN"
            label="영어"
            ariaLabel="영어로 읽기"
          />
        )}
        {hasPortuguese && (
          <TranslateButton href={`/pt/guides/${slug}`} code="PT" label="포르투갈어" ariaLabel="포르투갈어로 읽기" />
        )}
      </div>
    </header>

    <div class="prose-eland digest-body preview-body">
      <Content />
    </div>
  </article>

  <nav class="mx-auto mt-10 max-w-5xl border-t pt-6" style="border-color: var(--color-rule);">
    <a href={withBase("/ko/guides")} class="text-sm font-black no-underline transition-colors hover:text-white" style="color: var(--color-gold-light);">
      ← 모든 가이드
    </a>
  </nav>
</BaseLayout>
