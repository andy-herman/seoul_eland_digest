---
import { render } from "astro:content";
import { safeGetCollection } from "../../../lib/safeContent";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import MatchArticleHeader from "../../../components/MatchArticleHeader.astro";
import { withBase } from "../../../lib/paths";
import { koDigestMeta } from "../../../lib/koDigestMeta";

export async function getStaticPaths() {
  const digests = await safeGetCollection("digestsKo");
  return digests.map((entry) => ({
    params: { slug: entry.id.replace(/\.md$/, "") },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const slug = entry.id.replace(/\.md$/, "");

const { title: pageTitle, description: pageDescription } = koDigestMeta(entry);
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  lang="ko"
  ogType="article"
  publishedDate={entry.data.date.toISOString()}
>
  <article class="mx-auto max-w-5xl">
    <MatchArticleHeader
      slug={slug}
      season={entry.data.season}
      round={entry.data.round}
      date={entry.data.date}
      opponent={entry.data.opponent}
      venue={entry.data.venue}
      result={entry.data.result}
      locale="ko"
    />

    <div class="editorial-shell mx-auto">
      <div class="prose-eland digest-body mx-auto">
        <Content />
      </div>
    </div>
  </article>

  <nav class="mx-auto mt-10 max-w-5xl border-t pt-6" style="border-color: var(--color-rule);">
    <a href={withBase("/ko/")} class="text-sm font-black no-underline transition-colors hover:text-white" style="color: var(--color-gold-light);">
      ← 모든 라운드
    </a>
  </nav>
</BaseLayout>
