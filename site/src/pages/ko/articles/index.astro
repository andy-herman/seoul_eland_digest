---
import { safeGetCollection } from "../../../lib/safeContent"; import BaseLayout from "../../../layouts/BaseLayout.astro"; import TranslateButton from "../../../components/TranslateButton.astro"; import { withBase } from "../../../lib/paths"; import { partKo, seriesKo } from "../../../lib/i18n";
const articles=(await safeGetCollection("articlesKo")).sort((a,b)=>b.data.date.getTime()-a.data.date.getTime() || a.data.order-b.data.order);
const dateFmt=new Intl.DateTimeFormat("ko-KR",{year:"numeric",month:"long",day:"numeric",timeZone:"UTC"});
---
<BaseLayout title="서울 이랜드 기획·칼럼" description="서울 이랜드 FC를 다루는 한국어 기획 기사와 칼럼입니다." lang="ko"><section class="supporter-panel mb-8 rounded-[1.5rem] sm:mb-10 sm:rounded-[2rem]"><div class="relative p-5 sm:p-8 lg:p-10"><p class="eyebrow">기획·칼럼</p><h1 class="mt-3 text-[2.35rem] font-black leading-none tracking-tight sm:text-6xl">긴 글 모음</h1><p class="mt-4 max-w-2xl text-[0.95rem] leading-6 sm:text-lg sm:leading-8" style="color:var(--color-link);">승격 경쟁, 선수단, 구단의 흐름을 깊게 읽는 한국어 글입니다.</p><p class="hero-meta-line mt-4 text-sm font-black" style="color:var(--color-gold-light);">{articles.length}편</p><div class="hero-cta-row mt-4 flex flex-wrap items-center gap-3 sm:mt-7"><TranslateButton href="/articles" code="EN" label="영어" /><TranslateButton href="/pt/articles" code="PT" label="포르투갈어" /></div></div></section><section class="grid gap-4">{articles.map((article)=><a href={withBase(`/ko/articles/${article.id.replace(/\.md$/,"")}`)} class="group block rounded-2xl border p-5 no-underline transition duration-200 hover:-translate-y-0.5 sm:p-6" style="background:color-mix(in srgb,white 6%,transparent);border-color:color-mix(in srgb,var(--color-gold) 16%,var(--color-rule));"><div class="flex flex-wrap items-center gap-2"><span class="metadata-chip">{seriesKo(article.data.series)}</span>{article.data.part && <span class="metadata-chip">{partKo(article.data.part)}</span>}<span class="metadata-chip">{dateFmt.format(article.data.date)}</span></div><h2 class="mt-3 text-2xl font-black leading-tight tracking-tight transition-colors group-hover:text-white sm:text-3xl">{article.data.title}</h2><p class="mt-2 max-w-3xl text-sm font-bold leading-6" style="color:var(--color-link);">{article.data.description}</p><p class="mt-4 text-sm font-black" style="color:var(--color-gold-light);">읽기 →</p></a>)}</section>{articles.length===0 && <p class="rounded-2xl border p-6 font-black" style="border-color:var(--color-rule);">아직 한국어 기획·칼럼이 없습니다.</p>}</BaseLayout>
