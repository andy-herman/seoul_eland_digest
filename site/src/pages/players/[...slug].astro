---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getOfficialRosterWithPhotos, type OfficialPlayerWithPhoto } from "../../lib/officialRoster";
import { withBase } from "../../lib/paths";
import { fixtures, type MatchFixture } from "../../data/matches";
import { getPlayerProfile } from "../../data/playerProfiles";

export async function getStaticPaths() {
  const [players, notes] = await Promise.all([
    getOfficialRosterWithPhotos(),
    getCollection("players"),
  ]);

  return players.map((player) => {
    const entry = notes.find((note) => note.id.replace(/\.md$/, "").replace(/ /g, "-").toLowerCase() === player.slug);
    return {
      params: { slug: player.slug },
      props: { player, entry },
    };
  });
}

const { player, entry } = Astro.props as {
  player: OfficialPlayerWithPhoto;
  entry?: Awaited<ReturnType<typeof getCollection<"players">>>[number];
};
const title = `${player.englishName} — Seoul E-Land`;
const birthday = player.birthday
  ? new Date(player.birthday).toLocaleDateString("en-US", {
      year: "numeric",
      month: "long",
      day: "numeric",
    })
  : undefined;

function getMentions(body?: string) {
  if (!body) return [];

  return [...body.matchAll(/\[\[(2026-R\d+_Seoul_E-Land_Digest)\]\]\s*-\s*Round\s+(\d+),\s*([0-9-]+)/g)]
    .map((match) => ({
      id: match[1],
      round: match[2],
      date: new Date(`${match[3]}T12:00:00Z`).toLocaleDateString("en-US", {
        month: "short",
        day: "numeric",
        year: "numeric",
        timeZone: "UTC",
      }),
      href: withBase(`/rounds/${match[1].toLowerCase()}`),
    }));
}

const mentions = getMentions(entry?.body);

// Season stats, as published by the club on the player's own page.
const stats = player.stats ?? {};
const hasStats = stats.appearances != null || stats.goals != null || stats.assists != null;
const teamMatches = fixtures.filter((match: MatchFixture) => match.result && match.result !== "TBD").length;
const contributions = (stats.goals ?? 0) + (stats.assists ?? 0);
const minutesPerContribution =
  contributions > 0 && stats.minutes ? Math.round(stats.minutes / contributions) : undefined;
const appearanceShare =
  stats.appearances != null && teamMatches > 0
    ? Math.round((stats.appearances / teamMatches) * 100)
    : undefined;

const statCards = [
  { label: "Appearances", value: stats.appearances, sub: teamMatches ? `of ${teamMatches} played` : undefined },
  { label: "Goals", value: stats.goals },
  { label: "Assists", value: stats.assists },
  { label: "Minutes", value: stats.minutes, sub: "including stoppage" },
].filter((card) => card.value != null);

const profile = getPlayerProfile(player.slug);

// Back-of-the-card career table. Only shown when the club publishes more than
// the current season, otherwise the season cards above already say it all.
const career = player.career ?? [];
const sum = (key: "appearances" | "goals" | "assists" | "minutes" | "yellowCards" | "redCards") =>
  career.reduce((total, row) => total + (row[key] ?? 0), 0);
const careerTotals = {
  appearances: sum("appearances"),
  goals: sum("goals"),
  assists: sum("assists"),
  minutes: sum("minutes"),
  yellowCards: sum("yellowCards"),
  redCards: sum("redCards"),
};
const showCareer = career.length > 1;
const num = (value: number | undefined) => (value == null ? "-" : value.toLocaleString("en-US"));
---

<BaseLayout
  title={title}
  description={`${player.englishName}, Seoul E-Land ${player.englishPosition}.`}
>
  <article class="mx-auto max-w-5xl">
    <header class="supporter-panel overflow-hidden rounded-[2rem]">
      <div class="relative grid gap-6 p-6 sm:p-8 md:grid-cols-[0.85fr_1.15fr] lg:p-10">
        <div class="relative min-h-72 overflow-hidden rounded-[1.5rem] border sm:min-h-80" style="background: linear-gradient(145deg, var(--color-blue) 0%, var(--color-navy-deep) 76%); border-color: var(--color-rule);">
          <div class="absolute left-5 top-5 text-8xl font-black leading-none opacity-25" style="color: var(--color-gold);">
            {player.backNumber}
          </div>
          <img
            src={player.photoUrl}
            alt={`${player.englishName} player photo`}
            class="absolute bottom-0 right-0 h-full w-full object-contain object-bottom"
          />
        </div>

        <div class="flex min-w-0 flex-col justify-center">
          <p class="eyebrow">Seoul E-Land squad profile</p>
          <h1 class="mt-3 break-words text-4xl font-black uppercase tracking-tight sm:text-6xl">
            {player.englishName}
          </h1>
          <p class="mt-2 text-2xl font-bold" style="color: var(--color-gold-light);">{player.korName}</p>
          <div class="mt-6 flex flex-wrap gap-2">
            <span class="metadata-chip">#{player.backNumber}</span>
            <span class="metadata-chip">{player.englishPosition}</span>
            <span class="metadata-chip">{player.englishNationality}</span>
          </div>
          <dl class="mt-7 grid gap-4 text-sm min-[380px]:grid-cols-2 sm:grid-cols-3">
            <div class="rounded-2xl border p-4" style="background-color: color-mix(in srgb, white 8%, transparent); border-color: var(--color-rule);">
              <dt class="font-black uppercase tracking-[0.16em]" style="color: var(--color-muted);">Height</dt>
              <dd class="mt-2 text-xl font-black">{player.height ? `${player.height}cm` : "—"}</dd>
            </div>
            <div class="rounded-2xl border p-4" style="background-color: color-mix(in srgb, white 8%, transparent); border-color: var(--color-rule);">
              <dt class="font-black uppercase tracking-[0.16em]" style="color: var(--color-muted);">Weight</dt>
              <dd class="mt-2 text-xl font-black">{player.weight ? `${player.weight}kg` : "—"}</dd>
            </div>
            <div class="rounded-2xl border p-4" style="background-color: color-mix(in srgb, white 8%, transparent); border-color: var(--color-rule);">
              <dt class="font-black uppercase tracking-[0.16em]" style="color: var(--color-muted);">Born</dt>
              <dd class="mt-2 text-xl font-black">{birthday ?? "—"}</dd>
            </div>
          </dl>
        </div>
      </div>
    </header>

    {hasStats && (
      <section class="mt-8" aria-label={`${player.englishName} season statistics`}>
        <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
          <h2 class="text-2xl font-black uppercase tracking-tight">
            {stats.season ?? new Date().getFullYear()} season
          </h2>
          <p class="text-xs font-black uppercase tracking-[0.16em]" style="color: var(--color-muted);">
            K League 2 · official club figures
          </p>
        </div>

        <dl class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-4">
          {statCards.map((card) => (
            <div class="rounded-2xl border p-4" style="background-color: color-mix(in srgb, white 8%, transparent); border-color: var(--color-rule);">
              <dt class="text-xs font-black uppercase tracking-[0.16em]" style="color: var(--color-muted);">{card.label}</dt>
              <dd class="mt-2 text-3xl font-black leading-none">{card.value}</dd>
              {card.sub && (
                <p class="mt-1.5 text-xs font-bold" style="color: var(--color-muted);">{card.sub}</p>
              )}
            </div>
          ))}
        </dl>

        {(contributions > 0 || appearanceShare != null) && (
          <div class="mt-3 flex flex-wrap gap-2">
            {contributions > 0 && (
              <span class="metadata-chip">{contributions} goal {contributions === 1 ? "involvement" : "involvements"}</span>
            )}
            {minutesPerContribution && (
              <span class="metadata-chip">one every {minutesPerContribution} mins</span>
            )}
            {appearanceShare != null && (
              <span class="metadata-chip">
                {appearanceShare === 100 ? "ever present" : `${appearanceShare}% of matches`}
              </span>
            )}
          </div>
        )}
      </section>
    )}

    {showCareer && (
      <section class="mt-6" aria-label={`${player.englishName} career record`}>
        <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
          <h2 class="text-2xl font-black uppercase tracking-tight">Career at Seoul E-Land</h2>
          <p class="text-xs font-black uppercase tracking-[0.16em]" style="color: var(--color-muted);">
            season by season
          </p>
        </div>
        <div class="career-table-wrap mt-4 overflow-x-auto rounded-2xl border" style="border-color: var(--color-rule);" data-scroll-fade>
          <table class="w-full border-collapse text-sm">
            <thead>
              <tr style="background-color: color-mix(in srgb, white 10%, transparent);">
                <th class="px-3 py-2.5 text-left font-black uppercase tracking-[0.12em]">Season</th>
                <th class="px-3 py-2.5 text-right font-black uppercase tracking-[0.12em]">Apps</th>
                <th class="px-3 py-2.5 text-right font-black uppercase tracking-[0.12em]">G</th>
                <th class="px-3 py-2.5 text-right font-black uppercase tracking-[0.12em]">A</th>
                <th class="px-3 py-2.5 text-right font-black uppercase tracking-[0.12em]">Mins</th>
                <th class="px-3 py-2.5 text-right font-black uppercase tracking-[0.12em]" title="Yellow cards">Y</th>
                <th class="px-3 py-2.5 text-right font-black uppercase tracking-[0.12em]" title="Red cards">R</th>
              </tr>
            </thead>
            <tbody>
              {career.map((row) => (
                <tr class="border-t" style="border-color: var(--color-rule);">
                  <td class="px-3 py-2.5 font-black">{row.season}</td>
                  <td class="px-3 py-2.5 text-right tabular-nums">{num(row.appearances)}</td>
                  <td class="px-3 py-2.5 text-right tabular-nums font-black">{num(row.goals)}</td>
                  <td class="px-3 py-2.5 text-right tabular-nums">{num(row.assists)}</td>
                  <td class="px-3 py-2.5 text-right tabular-nums">{num(row.minutes)}</td>
                  <td class="px-3 py-2.5 text-right tabular-nums">{num(row.yellowCards)}</td>
                  <td class="px-3 py-2.5 text-right tabular-nums">{num(row.redCards)}</td>
                </tr>
              ))}
              <tr class="border-t-2" style="border-color: color-mix(in srgb, var(--color-gold) 45%, var(--color-rule)); background-color: color-mix(in srgb, white 6%, transparent);">
                <td class="px-3 py-2.5 font-black uppercase tracking-[0.1em]">Total</td>
                <td class="px-3 py-2.5 text-right tabular-nums font-black">{careerTotals.appearances}</td>
                <td class="px-3 py-2.5 text-right tabular-nums font-black">{careerTotals.goals}</td>
                <td class="px-3 py-2.5 text-right tabular-nums font-black">{careerTotals.assists}</td>
                <td class="px-3 py-2.5 text-right tabular-nums font-black">{careerTotals.minutes.toLocaleString("en-US")}</td>
                <td class="px-3 py-2.5 text-right tabular-nums font-black">{careerTotals.yellowCards}</td>
                <td class="px-3 py-2.5 text-right tabular-nums font-black">{careerTotals.redCards}</td>
              </tr>
            </tbody>
          </table>
        </div>
        <p class="mt-2 text-xs font-bold" style="color: var(--color-muted);">
          Club record only, as published by Seoul E-Land. Minutes include stoppage time.
        </p>
      </section>
    )}

    {profile && (
      <section class="mt-6" aria-label={`About ${player.englishName}`}>
        <div class="rounded-[1.5rem] border p-6 sm:p-7" style="background-color: color-mix(in srgb, white 7%, transparent); border-color: color-mix(in srgb, var(--color-gold) 30%, var(--color-rule));">
          <p class="text-xs font-black uppercase tracking-[0.2em]" style="color: var(--color-gold-light);">
            The scouting note
          </p>
          <p class="mt-3 text-base leading-relaxed sm:text-lg">{profile}</p>
        </div>
      </section>
    )}

    <section class="editorial-shell mx-auto mt-8">
      <div class="prose-eland digest-body mx-auto">
        <h2>Supporter note</h2>
        <p>
          {player.englishName} is listed in Seoul E-Land's current first-team squad as a {player.englishPosition.toLowerCase()}.
          This page collects the player profile details and any digest mentions as the season develops.
        </p>
        {mentions.length > 0 ? (
          <>
            <h2>Recent mentions</h2>
            <ul>
              {mentions.map((mention) => (
                <li>
                  <a href={mention.href}>Round {mention.round}</a> - {mention.date}
                </li>
              ))}
            </ul>
          </>
        ) : (
          <>
            <h2>Season watch</h2>
            <p>
              Match notes, key moments, and role changes will be added here as {player.englishName} features in future Seoul E-Land coverage.
            </p>
          </>
        )}
      </div>
    </section>
  </article>

  <nav class="mx-auto mt-10 max-w-5xl border-t pt-6" style="border-color: var(--color-rule);">
    <a href={withBase("/players")} class="text-sm font-black no-underline transition-colors hover:text-white" style="color: var(--color-gold-light);">
      ← Back to squad
    </a>
  </nav>
</BaseLayout>
