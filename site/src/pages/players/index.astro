---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getOfficialRosterWithPhotos } from "../../lib/officialRoster";
import { withBase } from "../../lib/paths";

const rosterWithPhotos = await getOfficialRosterWithPhotos();
---

<BaseLayout
  title="Seoul E-Land Squad"
  description="Current Seoul E-Land FC squad roster with player photos from the official club site."
>
  <header class="mb-10 overflow-hidden rounded-2xl border" style="background: linear-gradient(135deg, var(--color-navy) 0%, var(--color-blue) 100%); border-color: var(--color-rule);">
    <div class="px-6 py-8 sm:px-8">
      <p class="text-sm font-mono uppercase tracking-[0.25em]" style="color: var(--color-gold-light);">Seoul E-Land FC</p>
      <h1 class="mt-3 text-4xl font-black uppercase tracking-tight">Squad</h1>
      <p class="mt-3 max-w-prose" style="color: var(--color-link);">
        English-language squad guide with player photos, positions, shirt numbers, and quick profile links for Seoul E-Land supporters.
      </p>
    </div>
  </header>

  <section class="grid gap-5 sm:grid-cols-2">
    {rosterWithPhotos.map((player) => (
      <a href={withBase(`/players/${player.slug}`)} class="group block overflow-hidden rounded-2xl border no-underline transition duration-200 hover:-translate-y-1 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[var(--color-gold)]" style="background-color: var(--color-surface); border-color: var(--color-rule);">
        <div class="relative min-h-64 overflow-hidden" style="background: linear-gradient(145deg, var(--color-blue) 0%, var(--color-navy-deep) 75%);">
          <div class="absolute left-4 top-4 text-6xl font-black leading-none opacity-25" style="color: var(--color-gold);">
            {player.backNumber}
          </div>
          <img
            src={player.photoUrl}
            alt={`${player.englishName} player photo`}
            class="absolute bottom-0 right-0 h-64 w-full object-contain object-bottom transition-transform duration-300 group-hover:scale-105"
            loading="lazy"
            onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
          />
          <div class="absolute inset-0 hidden items-center justify-center text-5xl font-black" style="color: var(--color-gold);">
            {player.korName.slice(0, 1)}
          </div>
        </div>
        <div class="p-5">
          <div class="flex items-start justify-between gap-4">
            <div>
              <h2 class="text-2xl font-black tracking-tight">{player.englishName}</h2>
              <p class="mt-1 text-sm" style="color: var(--color-muted);">{player.korName}</p>
              <p class="mt-1 text-sm font-mono uppercase tracking-wider" style="color: var(--color-gold);">
                #{player.backNumber} · {player.englishPosition}
              </p>
              {player.stats?.appearances != null && (
                <p class="mt-2 text-sm font-black" style="color: var(--color-muted);">
                  {player.stats.appearances} {player.stats.appearances === 1 ? "app" : "apps"}
                  {(player.stats.goals ?? 0) > 0 && <> · {player.stats.goals}G</>}
                  {(player.stats.assists ?? 0) > 0 && <> · {player.stats.assists}A</>}
                </p>
              )}
            </div>
          </div>
          <dl class="mt-4 grid grid-cols-3 gap-3 text-sm">
            <div>
              <dt class="text-xs uppercase tracking-wider" style="color: var(--color-muted);">Nation</dt>
              <dd class="mt-1 font-semibold">{player.englishNationality}</dd>
            </div>
            <div>
              <dt class="text-xs uppercase tracking-wider" style="color: var(--color-muted);">Height</dt>
              <dd class="mt-1 font-semibold">{player.height ? `${player.height}cm` : "—"}</dd>
            </div>
            <div>
              <dt class="text-xs uppercase tracking-wider" style="color: var(--color-muted);">Weight</dt>
              <dd class="mt-1 font-semibold">{player.weight ? `${player.weight}kg` : "—"}</dd>
            </div>
          </dl>
        </div>
      </a>
    ))}
  </section>
</BaseLayout>
