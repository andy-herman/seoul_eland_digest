---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import MatchArticleHeader from "../../components/MatchArticleHeader.astro";
import { withBase } from "../../lib/paths";

export async function getStaticPaths() {
  const digests = await getCollection("digests");
  return digests.map((entry) => ({
    params: { slug: entry.id.replace(/\.md$/, "") },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const slug = entry.id.replace(/\.md$/, "");

const dateStr = entry.data.date.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
  timeZone: "UTC",
});
---

<BaseLayout
  title={`Round ${entry.data.round} — ${entry.data.opponent}`}
  description={`Seoul E-Land FC ${entry.data.result} ${entry.data.opponent}, ${dateStr}.`}
>
  <article class="mx-auto max-w-5xl">
    <MatchArticleHeader
      slug={slug}
      season={entry.data.season}
      round={entry.data.round}
      date={entry.data.date}
      opponent={entry.data.opponent}
      venue={entry.data.venue}
      result={entry.data.result}
    />

    <div class="editorial-shell mx-auto">
      <div class="prose-eland digest-body mx-auto">
        <Content />
      </div>
    </div>
  </article>

  <nav class="mx-auto mt-10 max-w-5xl border-t pt-6" style="border-color: var(--color-rule);">
    <a href={withBase("/")} class="text-sm font-black no-underline transition-colors hover:text-white" style="color: var(--color-gold-light);">
      ← All rounds
    </a>
  </nav>
</BaseLayout>
