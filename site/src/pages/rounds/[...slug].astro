---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ResultBadge from "../../components/ResultBadge.astro";
import TranslateButton from "../../components/TranslateButton.astro";
import { getTeamInitials, getTeamLogo } from "../../lib/teamLogos";
import { withBase } from "../../lib/paths";

export async function getStaticPaths() {
  const digests = await getCollection("digests");
  return digests.map((entry) => ({
    params: { slug: entry.id.replace(/\.md$/, "") },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const dateStr = entry.data.date.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
  timeZone: "UTC",
});
const shortDateStr = entry.data.date.toLocaleDateString("en-US", {
  weekday: "short",
  month: "short",
  day: "numeric",
  year: "numeric",
  timeZone: "UTC",
});
const opponentLogo = getTeamLogo(entry.data.opponent);
const opponentInitials = getTeamInitials(entry.data.opponent);
const resultLetter = entry.data.result.trim().charAt(0).toUpperCase();
const scorePart = entry.data.result.trim().slice(1).trim();
const [elandScore = "—", opponentScore = "—"] = scorePart.split("-").map((part) => part.trim());
const resultText =
  resultLetter === "W" ? "Seoul win" : resultLetter === "D" ? "Draw" : resultLetter === "L" ? "Seoul loss" : "Full time";
const venueLabel = entry.data.venue === "home" ? "Home" : entry.data.venue === "away" ? "Away" : "Neutral";
const matchupLabel = entry.data.venue === "home" ? `vs ${entry.data.opponent}` : entry.data.venue === "away" ? `at ${entry.data.opponent}` : `v ${entry.data.opponent}`;
---

<BaseLayout
  title={`Round ${entry.data.round} — ${entry.data.opponent}`}
  description={`Seoul E-Land FC ${entry.data.result} ${entry.data.opponent}, ${dateStr}.`}
>
  <article class="mx-auto max-w-5xl">
    <header class="supporter-panel not-prose mb-8 rounded-[2rem]">
      <div class="relative p-6 sm:p-8 lg:p-10">
        <div class="flex flex-wrap gap-2">
          <span class="metadata-chip">K League 2</span>
          <span class="metadata-chip">Season {entry.data.season}</span>
          <span class="metadata-chip">Round {entry.data.round}</span>
          <span class="metadata-chip">{venueLabel}</span>
          <time class="metadata-chip" datetime={entry.data.date.toISOString()}>{shortDateStr}</time>
        </div>

        <div class="mt-8 grid items-center gap-5 md:grid-cols-[1fr_auto_1fr]">
          <div class="rounded-3xl border p-5 text-center" style="background-color: color-mix(in srgb, white 8%, transparent); border-color: var(--color-rule);">
            <img src={withBase("/assets/crest.png")} alt="Seoul E-Land FC crest" class="mx-auto h-20 w-20 object-contain" />
            <p class="mt-3 text-sm font-black uppercase tracking-[0.14em]" style="color: var(--color-link);">Seoul E-Land FC</p>
          </div>

          <div class="text-center">
            <ResultBadge result={entry.data.result} />
            <div class="mt-4 flex items-baseline justify-center gap-2 font-black tabular-nums min-[380px]:gap-3">
              <span class="text-5xl leading-none min-[380px]:text-6xl sm:text-7xl" style="color: var(--color-ink);">{elandScore}</span>
              <span class="text-3xl min-[380px]:text-4xl" style="color: var(--color-gold-light);">–</span>
              <span class="text-5xl leading-none min-[380px]:text-6xl sm:text-7xl" style="color: var(--color-ink);">{opponentScore}</span>
            </div>
            <p class="mt-3 text-xs font-black uppercase tracking-[0.18em]" style="color: var(--color-gold-light);">
              {resultText} · Full time
            </p>
          </div>

          <div class="rounded-3xl border p-5 text-center" style="background-color: color-mix(in srgb, white 8%, transparent); border-color: var(--color-rule);">
            <span class="mx-auto flex h-20 w-20 items-center justify-center rounded-2xl bg-white p-3">
              {opponentLogo ? (
                <img src={opponentLogo} alt={`${entry.data.opponent} logo`} class="h-full w-full object-contain" />
              ) : (
                <span class="text-xl font-black" style="color: var(--color-navy);">{opponentInitials}</span>
              )}
            </span>
            <p class="mt-3 text-sm font-black uppercase tracking-[0.14em]" style="color: var(--color-link);">{entry.data.opponent}</p>
          </div>
        </div>

        <div class="mt-8 max-w-3xl">
          <p class="eyebrow">Match digest</p>
          <h1 class="mt-3 text-3xl font-black tracking-tight sm:text-5xl">
            Round {entry.data.round}: {matchupLabel}
          </h1>
          <p class="mt-4 text-base leading-7 sm:text-lg sm:leading-8" style="color: var(--color-link);">
            A supporter-focused match report with tactical notes, player context, and the wider promotion-race read.
          </p>
          <div class="mt-5 flex flex-wrap items-center gap-3">
            <TranslateButton />
            <p class="text-sm font-semibold" style="color: var(--color-muted);">
              Opens a Portuguese version in Google Translate.
            </p>
          </div>
        </div>
      </div>
    </header>

    <div class="editorial-shell mx-auto">
      <div class="prose-eland digest-body mx-auto">
        <Content />
      </div>
    </div>
  </article>

  <nav class="mx-auto mt-10 max-w-5xl border-t pt-6" style="border-color: var(--color-rule);">
    <a href={withBase("/")} class="text-sm font-black no-underline transition-colors hover:text-white" style="color: var(--color-gold-light);">
      ← All rounds
    </a>
  </nav>
</BaseLayout>
