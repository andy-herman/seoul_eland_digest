---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { withBase } from "../lib/paths";

interface Props {
  title: string;
  description?: string;
  lang?: string;
  /** "article" for digests, previews, and guides; defaults to "website". */
  ogType?: "website" | "article";
  /** ISO date for article JSON-LD and og:article:published_time. */
  publishedDate?: string;
}

const { title, description, lang = "en", ogType = "website", publishedDate } = Astro.props;
const locale = lang === "pt" ? "pt" : "en";
const siteName = "Seoul E-Land Digest";
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
const ogImageUrl = new URL(withBase("/assets/og-card.png"), Astro.site).href;
const jsonLd =
  ogType === "article"
    ? JSON.stringify({
        "@context": "https://schema.org",
        "@type": "NewsArticle",
        headline: title,
        description: description || undefined,
        datePublished: publishedDate || undefined,
        inLanguage: locale === "pt" ? "pt-BR" : "en",
        image: [ogImageUrl],
        author: { "@type": "Organization", name: siteName },
        publisher: { "@type": "Organization", name: siteName, logo: { "@type": "ImageObject", url: new URL(withBase("/assets/crest.png"), Astro.site).href } },
        mainEntityOfPage: canonicalUrl,
      })
    : undefined;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/png" href={withBase("/assets/crest.png")} />
    <link rel="icon" type="image/svg+xml" href={withBase("/assets/crest.svg")} />
    <link rel="alternate" type="application/rss+xml" title={siteName} href={new URL(withBase("/rss.xml"), Astro.site).href} />
    <link rel="sitemap" href={withBase("/sitemap.xml")} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={locale === "pt" ? "pt_BR" : "en_US"} />
    {ogType === "article" && publishedDate && <meta property="article:published_time" content={publishedDate} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={ogImageUrl} />
    {jsonLd && <script type="application/ld+json" set:html={jsonLd} />}
    <script defer src={withBase("/_vercel/insights/script.js")}></script>
  </head>
  <body class="min-h-screen flex flex-col">
    <Header locale={locale} />
    <main class="flex-1 px-4 py-6 sm:px-6 sm:py-10 mx-auto w-full max-w-6xl">
      <slot />
    </main>
    <Footer locale={locale} />
    <script>
      // Horizontal scrollers get an edge fade so it is visible on a phone that
      // there is more content sideways. Also scrolls the active nav tab into
      // view, which both reveals the current page and hints at the swipe.
      document.querySelectorAll<HTMLElement>("[data-scroll-fade]").forEach((el) => {
        const update = () => {
          const max = el.scrollWidth - el.clientWidth;
          if (max <= 2) {
            el.removeAttribute("data-fade");
            return;
          }
          const atLeft = el.scrollLeft > 2;
          const atRight = el.scrollLeft < max - 2;
          el.setAttribute("data-fade", atLeft && atRight ? "both" : atLeft ? "left" : "right");
        };
        el.addEventListener("scroll", update, { passive: true });
        window.addEventListener("resize", update);

        const active = el.querySelector<HTMLElement>("[aria-current='page']");
        if (active) {
          const a = active.getBoundingClientRect();
          const e = el.getBoundingClientRect();
          if (a.right > e.right - 8 || a.left < e.left + 8) {
            el.scrollLeft += a.left - e.left - (e.width - a.width) / 2;
          }
        }
        update();
      });
    </script>
  </body>
</html>
