---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import PawPrints from "../components/PawPrints.astro";
import { withBase, stripBase } from "../lib/paths";
import { asLocale, htmlLang, ogLocale, type AlternateLink, type Locale } from "../lib/i18n";
import { safeGetCollection } from "../lib/safeContent";
import { getPreMatchPreviews } from "../lib/prematchPreviews";

interface Props {
  title: string;
  description?: string;
  lang?: string;
  /** "article" for digests, previews, and guides; defaults to "website". */
  ogType?: "website" | "article";
  /** ISO date for article JSON-LD and og:article:published_time. */
  publishedDate?: string;
  /** Site-relative 1200x630 share image; defaults to the site-wide card. */
  ogImage?: string;
  alternates?: AlternateLink[];
}

const { title, description, lang = "en", ogType = "website", publishedDate, ogImage = "/assets/og-card.png", alternates } = Astro.props;
const locale = asLocale(lang);
const siteName = "Seoul E-Land Digest";
// Mirror builds (GitHub Pages) set CANONICAL_SITE so search engines credit the
// main domain instead of the mirror.
const canonicalSite = process.env.CANONICAL_SITE?.trim();
const canonicalUrl = canonicalSite
  ? new URL(stripBase(Astro.url.pathname), canonicalSite).href
  : new URL(Astro.url.pathname, Astro.site).href;
const ogImageUrl = new URL(withBase(ogImage), Astro.site).href;
const languageAlternates =
  alternates ??
  ([
    { lang: "en", href: stripBase(Astro.url.pathname).replace(/^\/(pt|ko)(?=\/|$)/, "") || "/" },
    { lang: "pt", href: stripBase(Astro.url.pathname).replace(/^\/(pt|ko)(?=\/|$)/, "/pt") || "/pt/" },
    { lang: "ko", href: stripBase(Astro.url.pathname).replace(/^\/(pt|ko)(?=\/|$)/, "/ko") || "/ko/" },
    { lang: "x-default", href: stripBase(Astro.url.pathname).replace(/^\/(pt|ko)(?=\/|$)/, "") || "/" },
  ] satisfies AlternateLink[]);
const alternateHrefLang: Record<Locale | "x-default", string> = { en: "en", pt: "pt-BR", ko: "ko", "x-default": "x-default" };
const koRounds =
  locale === "ko"
    ? (await safeGetCollection("digestsKo")).map((entry) => entry.id.replace(/\.md$/, "").toLowerCase())
    : [];
const koPreviews = locale === "ko" ? getPreMatchPreviews("ko").map((preview) => preview.slug) : [];
const basePath = withBase("/").replace(/\/$/, "");
const jsonLd =
  ogType === "article"
    ? JSON.stringify({
        "@context": "https://schema.org",
        "@type": "NewsArticle",
        headline: title,
        description: description || undefined,
        datePublished: publishedDate || undefined,
        inLanguage: locale === "pt" ? "pt-BR" : htmlLang[locale],
        image: [ogImageUrl],
        author: { "@type": "Organization", name: siteName },
        publisher: { "@type": "Organization", name: siteName, logo: { "@type": "ImageObject", url: new URL(withBase("/assets/crest.png"), Astro.site).href } },
        mainEntityOfPage: canonicalUrl,
      })
    : undefined;
---

<!doctype html>
<html lang={htmlLang[locale]}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonicalUrl} />
    {languageAlternates.map((alternate) => (
      <link
        rel="alternate"
        hreflang={alternateHrefLang[alternate.lang]}
        href={new URL(withBase(alternate.href), Astro.site).href}
      />
    ))}
    <link rel="icon" type="image/png" href={withBase("/assets/crest.png")} />
    <link rel="icon" type="image/svg+xml" href={withBase("/assets/crest.svg")} />
    <link rel="alternate" type="application/rss+xml" title={siteName} href={new URL(withBase(locale === "ko" ? "/ko/rss.xml" : "/rss.xml"), Astro.site).href} />
    <link rel="sitemap" href={withBase("/sitemap.xml")} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={ogLocale[locale]} />
    {(["en", "pt", "ko"] as Locale[]).filter((item) => item !== locale).map((item) => (
      <meta property="og:locale:alternate" content={ogLocale[item]} />
    ))}
    {ogType === "article" && publishedDate && <meta property="article:published_time" content={publishedDate} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={ogImageUrl} />
    {jsonLd && <script type="application/ld+json" set:html={jsonLd} />}
    <script defer src={withBase("/_vercel/insights/script.js")}></script>
  </head>
  <body class="min-h-screen flex flex-col">
    <Header locale={locale} />
    <main class="flex-1 px-4 py-6 sm:px-6 sm:py-10 mx-auto w-full max-w-6xl">
      <slot />
    </main>
    <Footer locale={locale} />
    {locale !== "ko" && <PawPrints />}
    {locale === "ko" && (
      <script
        is:inline
        set:html={`(() => {
  const base = ${JSON.stringify(basePath)};
  const koRounds = new Set(${JSON.stringify(koRounds)});
  const koPreviews = new Set(${JSON.stringify(koPreviews)});
  const stripBase = (path) => base && path.startsWith(base + "/") ? path.slice(base.length) : path;
  const addBase = (path) => (base || "") + path;
  for (const anchor of document.querySelectorAll("a[href]")) {
    const raw = anchor.getAttribute("href");
    if (!raw || raw.startsWith("#") || raw.startsWith("mailto:") || raw.startsWith("tel:")) continue;
    let url;
    try { url = new URL(raw, window.location.href); } catch { continue; }
    if (url.origin !== window.location.origin) continue;
    const path = stripBase(url.pathname).replace(/\\/$/, "");
    let target;
    const player = path.match(/^\\/players\\/([^/]+)$/);
    const round = path.match(/^\\/rounds\\/([^/]+)$/);
    const preview = path.match(/^\\/previews\\/([^/]+)$/);
    if (player) target = "/ko/players/" + player[1];
    else if (round && koRounds.has(round[1])) target = "/ko/rounds/" + round[1];
    else if (preview && koPreviews.has(preview[1])) target = "/ko/previews/" + preview[1];
    if (target) anchor.setAttribute("href", addBase(target) + url.search + url.hash);
  }
})();`}
      />
    )}
    <script>
      // Horizontal scrollers get an edge fade so it is visible on a phone that
      // there is more content sideways. Also scrolls the active nav tab into
      // view, which both reveals the current page and hints at the swipe.
      document.querySelectorAll<HTMLElement>("[data-scroll-fade]").forEach((el) => {
        const update = () => {
          const max = el.scrollWidth - el.clientWidth;
          if (max <= 2) {
            el.removeAttribute("data-fade");
            return;
          }
          const atLeft = el.scrollLeft > 2;
          const atRight = el.scrollLeft < max - 2;
          el.setAttribute("data-fade", atLeft && atRight ? "both" : atLeft ? "left" : "right");
        };
        el.addEventListener("scroll", update, { passive: true });
        window.addEventListener("resize", update);

        const active = el.querySelector<HTMLElement>("[aria-current='page']");
        if (active) {
          const a = active.getBoundingClientRect();
          const e = el.getBoundingClientRect();
          if (a.right > e.right - 8 || a.left < e.left + 8) {
            el.scrollLeft += a.left - e.left - (e.width - a.width) / 2;
          }
        }
        update();
      });
    </script>
  </body>
</html>
