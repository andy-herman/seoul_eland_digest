# ============================================================
# Copy this file to .env and fill in your Azure OpenAI deployment details
# DO NOT commit .env to version control
# ============================================================
# Auth is keyless: requires `az login` to have been run on this machine.
# These values match the Azure OpenAI deployment used by your other agent
# projects on this machine.

AZURE_OPENAI_ENDPOINT=https://your-endpoint.services.ai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-5.4-2
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_TOKEN_SCOPE=https://ai.azure.com/.default
